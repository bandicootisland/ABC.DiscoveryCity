@page "/metadata-inspector"
@using ABC.BookCity.Services
@using System.IO
@using System.IO.Compression

<h3>Metadata Inspector</h3>

<div class="alert alert-secondary">
    Use this tool to inspect the contents of the <code>.gz</code> files found in the torrent. 
    It will decompress and read the first 20 lines to show you the data structure.
</div>

<div class="mb-4">
    <label class="form-label">Select a .gz file (e.g., aarecords__0.json.gz):</label>
    <InputFile OnChange="@LoadFile" class="form-control" />
</div>

@if (isLoading)
{
    <div class="d-flex align-items-center">
        <div class="spinner-border text-primary me-3" role="status"></div>
        <span>Decompressing and reading stream...</span>
    </div>
}
else if (lines.Any())
{
    <h4>File Preview (First @lines.Count lines)</h4>
    <div class="card">
        <div class="card-body bg-light">
            <pre style="white-space: pre-wrap; font-size: 0.85rem;">
@foreach (var line in lines)
{
@line
<hr class="my-1"/>
}
            </pre>
        </div>
    </div>
}

@code {
    private List<string> lines = new();
    private bool isLoading = false;
    private string hexDump = "";
    private string detectedType = "Unknown";

    private async Task LoadFile(InputFileChangeEventArgs e)
    {
        isLoading = true;
        lines.Clear();
        hexDump = "";
        detectedType = "Unknown";

        try
        {
            // Increase limit to 10GB to allow opening large files
            long maxFileSize = 1024L * 1024L * 1024L * 10L; 
            
            // Create a buffer for the chunk (64KB)
            var buffer = new byte[64 * 1024];
            int bytesRead = 0;

            // Open, read chunk, close immediately
            using (var stream = e.File.OpenReadStream(maxFileSize))
            {
                // Use Span/Memory based read
                bytesRead = await stream.ReadAsync(buffer.AsMemory());
            }

            if (bytesRead == 0)
            {
                lines.Add("File is empty.");
                return;
            }

            // Analyze Header
            hexDump = BitConverter.ToString(buffer, 0, Math.Min(bytesRead, 32));
            
            // Check if the file starts with zeros (common for pre-allocated but not downloaded files)
            bool isAllZeros = true;
            for(int i=0; i<Math.Min(bytesRead, 1024); i++) {
                if (buffer[i] != 0) { isAllZeros = false; break; }
            }

            if (isAllZeros)
            {
                lines.Add($"File Name: {e.File.Name}");
                lines.Add($"File Size: {e.File.Size:N0} bytes");
                lines.Add("WARNING: The beginning of the file contains only null bytes (0x00).");
                lines.Add("This usually indicates that the file has been pre-allocated by the torrent client");
                lines.Add("but the first piece has NOT been downloaded yet.");
                lines.Add("Please ensure the Downloader is running and this file is prioritized/downloading.");
                
                // Try to find ANY data in the file
                lines.Add("Scanning for data...");
                // We can't easily scan the whole file in browser, but we can check a few offsets
                long[] offsets = { 1024 * 1024, e.File.Size / 2, e.File.Size - 64 * 1024 };
                foreach(var offset in offsets)
                {
                    if (offset >= e.File.Size) continue;
                    using var probeStream = e.File.OpenReadStream(maxFileSize);
                    // Skip is not supported on BrowserFileStream usually, need to read or create new stream?
                    // Actually OpenReadStream doesn't support Seek. We have to read.
                    // But reading 1GB is slow. 
                    // Let's just advise the user to check the download.
                }
                return;
            }

            bool isGzipMagic = (bytesRead >= 2 && buffer[0] == 0x1F && buffer[1] == 0x8B);
            bool isGzipExt = e.File.Name.EndsWith(".gz", StringComparison.OrdinalIgnoreCase);

            if (isGzipMagic) detectedType = "GZIP (Magic)";
            else if (isGzipExt) detectedType = "GZIP (Extension only)";
            else if (bytesRead >= 4 && buffer[0] == 0x50 && buffer[1] == 0x4B && buffer[2] == 0x03 && buffer[3] == 0x04) detectedType = "ZIP";
            else if (bytesRead >= 4 && buffer[0] == 0x28 && buffer[1] == 0xB5 && buffer[2] == 0x2F && buffer[3] == 0xFD) detectedType = "Zstd";
            else detectedType = "Unknown/Raw";

            lines.Add($"File Name: {e.File.Name}");
            lines.Add($"File Size: {e.File.Size:N0} bytes");
            lines.Add($"First 32 Bytes: {hexDump}");
            lines.Add($"Detected Type: {detectedType}");
            lines.Add("----------------------------------------");

            // Process the chunk
            if (detectedType.StartsWith("GZIP"))
            {
                try 
                {
                    using var memStream = new MemoryStream(buffer, 0, bytesRead);
                    using var gzipStream = new GZipStream(memStream, CompressionMode.Decompress);
                    using var reader = new StreamReader(gzipStream);
                    
                    lines.Add("Attempting GZIP Decompression...");
                    for(int i=0; i<20; i++) 
                    {
                        var line = await reader.ReadLineAsync();
                        if(line == null) break;
                        lines.Add(line);
                    }
                }
                catch(Exception ex)
                {
                    lines.Add($"Error decompressing chunk: {ex.Message}");
                    lines.Add("Note: Chunk might be too small for full decompression context, or file is corrupt.");
                    
                    // Fallback: Try reading as plain text in case it's not actually gzipped
                    lines.Add("----------------------------------------");
                    lines.Add("Fallback: Attempting to read as Plain Text...");
                    try 
                    {
                        string text = System.Text.Encoding.UTF8.GetString(buffer, 0, Math.Min(bytesRead, 1000));
                        // Sanitize control characters for display
                        text = new string(text.Where(c => !char.IsControl(c) || c == '\n' || c == '\r' || c == '\t').ToArray());
                        lines.Add(text.Substring(0, Math.Min(text.Length, 500)) + "...");
                    }
                    catch {}
                }
            }
            else 
            {
                // Text
                lines.Add("Reading as Plain Text...");
                string text = System.Text.Encoding.UTF8.GetString(buffer, 0, bytesRead);
                using var reader = new StringReader(text);
                for(int i=0; i<20; i++) 
                {
                    var line = await reader.ReadLineAsync();
                    if(line == null) break;
                    lines.Add(line);
                }
            }
        }
        catch (Exception ex)
        {
            lines.Add($"Error: {ex.Message}");
            lines.Add($"Hex Dump: {hexDump}");
            lines.Add($"Detected Type: {detectedType}");
        }
        finally
        {
            isLoading = false;
        }
    }
        }
        finally
        {
            isLoading = false;
        }
    }
}

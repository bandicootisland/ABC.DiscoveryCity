@page "/downloader"
@inject IJSRuntime JS

<h3>Book Downloader</h3>

<div class="row">
    <div class="col-md-6">
        <div class="mb-3">
            <label for="targetUrl" class="form-label">Target URL</label>
            <input type="text" class="form-control" id="targetUrl" @bind="targetUrl" />
        </div>
        <div class="mb-3">
            <label for="targetFolder" class="form-label">Target Folder</label>
            <input type="text" class="form-control" id="targetFolder" @bind="targetFolder" />
            <small class="text-muted">Note: Due to browser security, files will typically save to your default Downloads folder unless you configure your browser otherwise.</small>
        </div>
        <button class="btn btn-primary" @onclick="DownloadTorrent">Download Torrent</button>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12">
        <h4>Preview</h4>
        <div class="border p-2">
            <iframe src="@targetUrl" style="width: 100%; height: 600px; border: none;"></iframe>
        </div>
    </div>
</div>

@code {
    private string targetUrl ="";// "https://annas-archive.org/dyn/small_file/torrents/other_aa/aa_derived_mirror_metadata/aa_derived_mirror_metadata_20251121.torrent";
    private string targetFolder = @"H:\BookCity\Books";

    private async Task DownloadTorrent()
    {
        if (!string.IsNullOrWhiteSpace(targetUrl))
        {
            // Extract filename from URL or default to something sensible
            string fileName = "download.torrent";
            try 
            {
                var uri = new Uri(targetUrl);
                fileName = System.IO.Path.GetFileName(uri.LocalPath);
            }
            catch {}

            await JS.InvokeVoidAsync("triggerFileDownload", targetUrl, fileName);
        }
    }
}

@page "/import-monitor"
@using System.IO
@using System.Text.Json
@inject IJSRuntime JS

<h3>Import Monitor</h3>

<div class="card mb-3">
    <div class="card-body">
        <div class="row g-3">
            <!-- Source Folder -->
            <div class="col-md-6">
                <label class="form-label fw-bold">1. Source Folder (Metadata Files)</label>
                <div class="input-group">
                    <button class="btn btn-primary" @onclick="SelectSourceFolder">
                        <span class="oi oi-folder"></span> Select
                    </button>
                    <input type="text" class="form-control" value="@sourcePath" readonly placeholder="Select the folder with .sql.gz and .dat.gz files" />
                </div>
            </div>

            <!-- Data Folder -->
            <div class="col-md-6">
                <label class="form-label fw-bold">2. Data Folder (History)</label>
                <div class="input-group">
                    <button class="btn btn-secondary" @onclick="SelectDataFolder">
                        <span class="oi oi-folder"></span> Select
                    </button>
                    <input type="text" class="form-control" value="@dataPath" readonly placeholder="Select H:\_DOCKER-DATA" />
                </div>
            </div>
        </div>
        
        <div class="mt-3">
            <button class="btn btn-success" @onclick="LoadData" disabled="@(string.IsNullOrEmpty(sourcePath))">
                <span class="oi oi-reload"></span> Load / Refresh Files
            </button>
        </div>
    </div>
</div>

@if (files.Any())
{
    <div class="mb-2">
        <span class="badge bg-primary">Total: @files.Count</span>
        <span class="badge bg-success">Imported: @files.Count(f => f.IsImported)</span>
        <span class="badge bg-warning text-dark">Pending: @files.Count(f => !f.IsImported)</span>
    </div>

    <TelerikGrid Data="@files"
                 Pageable="true"
                 PageSize="20"
                 Sortable="true"
                 FilterMode="@GridFilterMode.FilterMenu"
                 Resizable="true"
                 Height="600px">
        <GridToolBarTemplate>
            <span class="k-toolbar-spacer"></span>
            <GridSearchBox />
        </GridToolBarTemplate>
        <GridColumns>
            <GridColumn Field="@nameof(ImportFileModel.Table)" Title="Table Name" Width="250px" />
            <GridColumn Field="@nameof(ImportFileModel.Type)" Title="Type" Width="100px">
                <Template>
                    @{
                        var item = context as ImportFileModel;
                        if (item.Type == "Schema")
                        {
                            <span class="badge bg-info text-dark">Schema</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Data</span>
                        }
                    }
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(ImportFileModel.Name)" Title="File Name" />
            <GridColumn Field="@nameof(ImportFileModel.SizeMB)" Title="Size (MB)" Width="120px" DisplayFormat="{0:N2}" />
            <GridColumn Field="@nameof(ImportFileModel.IsImported)" Title="Status" Width="150px">
                <Template>
                    @{
                        var item = context as ImportFileModel;
                        if (item.IsImported)
                        {
                            <span class="text-success fw-bold"><span class="oi oi-check"></span> Imported</span>
                        }
                        else
                        {
                            <span class="text-muted">Pending</span>
                        }
                    }
                </Template>
            </GridColumn>
        </GridColumns>
    </TelerikGrid>
}

@code {
    private string sourcePath = "";
    private string dataPath = "";
    private List<ImportFileModel> files = new();
    private HashSet<string> importedFiles = new();

    private async Task SelectSourceFolder()
    {
        sourcePath = await JS.InvokeAsync<string>("fileSystem.selectDirectory");
        if (!string.IsNullOrEmpty(sourcePath) && !string.IsNullOrEmpty(dataPath))
        {
            await LoadData();
        }
    }

    private async Task SelectDataFolder()
    {
        dataPath = await JS.InvokeAsync<string>("fileSystem.selectDataDirectory");
        if (!string.IsNullOrEmpty(sourcePath) && !string.IsNullOrEmpty(dataPath))
        {
            await LoadData();
        }
    }

    private async Task LoadData()
    {
        // 1. Load History
        importedFiles.Clear();
        if (!string.IsNullOrEmpty(dataPath))
        {
            var json = await JS.InvokeAsync<string>("fileSystem.readHistoryFile");
            if (!string.IsNullOrEmpty(json))
            {
                try
                {
                    var list = JsonSerializer.Deserialize<List<string>>(json);
                    if (list != null)
                    {
                        importedFiles = new HashSet<string>(list, StringComparer.OrdinalIgnoreCase);
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error reading history: {ex.Message}");
                }
            }
        }

        // 2. Load Files
        if (!string.IsNullOrEmpty(sourcePath))
        {
            var rawFiles = await JS.InvokeAsync<List<FileDto>>("fileSystem.listFiles");
            
            files = rawFiles
                .Where(f => f.Name.EndsWith(".gz"))
                .Select(f => ParseFile(f))
                .OrderBy(f => f.Table)
                .ThenBy(f => f.Type) // Schema first usually
                .ThenBy(f => f.Name)
                .ToList();
        }
    }

    private ImportFileModel ParseFile(FileDto f)
    {
        var model = new ImportFileModel
        {
            Name = f.Name,
            Size = f.Size,
            IsImported = importedFiles.Contains(f.Name)
        };

        // Infer Table and Type
        // Format: allthethings.TABLE_NAME.00000.dat.gz
        // Format: allthethings.TABLE_NAME-schema.sql.gz
        
        if (f.Name.Contains("-schema.sql.gz"))
        {
            model.Type = "Schema";
            model.Table = f.Name.Replace("allthethings.", "").Replace("-schema.sql.gz", "");
        }
        else if (f.Name.Contains(".dat.gz"))
        {
            model.Type = "Data";
            var parts = f.Name.Split('.');
            if (parts.Length >= 3)
            {
                // allthethings.isbndb_isbns.00000.dat.gz
                // 0=allthethings, 1=isbndb_isbns, 2=00000
                model.Table = parts[1];
            }
            else
            {
                model.Table = "Unknown";
            }
        }
        else
        {
            model.Type = "Other";
            model.Table = "Unknown";
        }

        return model;
    }

    public class ImportFileModel
    {
        public string Name { get; set; }
        public long Size { get; set; }
        public double SizeMB => Size / 1024.0 / 1024.0;
        public string Table { get; set; }
        public string Type { get; set; } // Schema, Data
        public bool IsImported { get; set; }
    }

    public class FileDto
    {
        public string Name { get; set; }
        public long Size { get; set; }
        public long LastModified { get; set; }
    }
}

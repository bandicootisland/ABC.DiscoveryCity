@page "/search"
@using ABC.DiscoveryCity.Services
@using Telerik.Blazor
@using Telerik.Blazor.Components
@using Telerik.Blazor.Components.Common.Icon
@using static ABC.DiscoveryCity.Services.TextFormatExtensions
@inject SearchService SearchService

<PageTitle>Discovery Search</PageTitle>

<div class="container-fluid">
    <h3>Discovery Search</h3>
    
    <div class="row mb-3">
        <div class="col-md-4">
            <form @onsubmit="PerformSearch">
                <div class="input-group">
                    <TelerikTextBox @bind-Value="@SearchQuery" PlaceHolder="Enter search term..." Width="100%" />
                    <TelerikButton ButtonType="@ButtonType.Submit" Icon="@SvgIcon.Search">Search</TelerikButton>
                </div>
            </form>
        </div>
        <div class="col-md-2">
            <TelerikCheckBox @bind-Value="@ExactMatchOnly" Id="exactMatch" />
            <label for="exactMatch" class="ms-1" title="Only return documents containing the exact search text">Exact Match</label>
        </div>
        <div class="col-md-3">
            <TelerikMultiSelect Data="@AvailableDataSets"
                                @bind-Value="@SelectedDataSets"
                                Placeholder="All DataSets"
                                Width="100%"
                                AutoClose="false"
                                OnChange="@OnDataSetFilterChanged" />
        </div>
        <div class="col-md-3">
            <div class="d-flex align-items-center gap-1">
                <TelerikMultiSelect Data="@AvailableNames"
                                    @bind-Value="@SelectedNames"
                                    Placeholder="Name filter..."
                                    Width="100%"
                                    AutoClose="false"
                                    Filterable="true"
                                    AllowCustom="true" />
                <TelerikButton OnClick="@OnNamesSearchClicked" Icon="@SvgIcon.Search" Title="Search with selected name filter"
                               Enabled="@(SelectedNames.Count > 0)" ThemeColor="@ThemeConstants.Button.ThemeColor.Primary" />
            </div>
        </div>
    </div>

    @if (IsSearching)
    {
        <div class="alert alert-info">Searching...</div>
    }
    else if (GridData != null && GridData.Count == 0 && TotalCount == 0 && HasSearched)
    {
        <div class="alert alert-warning">No results found.</div>
    }

    @if (TotalCount > 0)
    {
        <div class="mb-2 text-muted"><strong>@TotalCount.ToString("N0")</strong> documents found</div>
    }
    <TelerikGrid @ref="GridRef"
                 TItem="SearchResultDto"
                 OnRead="@OnGridRead"
                 Sortable="true"
                 Resizable="true"
                 FilterMode="@GridFilterMode.FilterRow"
                 ScrollMode="@GridScrollMode.Virtual"
                 PageSize="50"
                 RowHeight="60"
                 Height="calc(100vh - 200px)"
                 OnRowClick="@OnRowClick">
            <GridColumns>
                <GridColumn Title="Thumb" Width="80px">
                     <Template>
                        @{
                            var item = context as SearchResultDto;
                            var thumbPath = item?.ThumbnailPath;
                            if (!string.IsNullOrEmpty(thumbPath))
                            {
                                <img src="@($"http://localhost:5022/api/images/view?path={Uri.EscapeDataString(thumbPath)}")" 
                                     style="width: 50px; height: auto; border: 1px solid #ddd; border-radius: 4px;" 
                                     alt="Thumb" />
                            }
                            else
                            {
                                <div style="width: 50px; height: 70px; background: #f0f0f0; display: flex; align-items: center; justify-content: center; color: #aaa;">
                                    <TelerikIcon Icon="@SvgIcon.FilePdf" />
                                </div>
                            }
                        }
                     </Template>
                </GridColumn>
                <GridColumn Field="@nameof(SearchResultDto.FileName)" Title="File Name" Width="200px" />
                <GridColumn Field="@nameof(SearchResultDto.Date)" Title="Date (Estimated)" Width="120px" DisplayFormat="{0:yyyy-MM-dd}" />
                <GridColumn Field="@nameof(SearchResultDto.PageCount)" Title="Pages" Width="80px" />
                <GridColumn Field="@nameof(SearchResultDto.DataSetName)" Title="DataSet" Width="120px" Filterable="true" />
                <GridColumn Title="Names" Width="150px">
                    <Template>
                        @{
                            var item = context as SearchResultDto;
                            if (item?.Names != null && item.Names.Count > 0)
                            {
                                <div style="font-size: 0.85em; line-height: 1.4;">
                                    @foreach (var name in item.Names)
                                    {
                                        <span class="badge me-1 mb-1 @(GetBadgeClass(name))"
                                              style="font-weight: normal; cursor: pointer;"
                                              title="Click to add to Name filter"
                                              @onclick="() => AddNameToFilter(name)"
                                              @onclick:stopPropagation="true">@name</span>
                                    }
                                </div>
                            }
                            else
                            {
                                <span style="color: #ccc;">—</span>
                            }
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(SearchResultDto.Distance)" Title="Relevance" DisplayFormat="{0:F4}" Width="100px" />
                <GridColumn Field="@nameof(SearchResultDto.Text)" Title="Preview Text">
                    <Template>
                        @{
                            var item = context as SearchResultDto;
                            var preview = item?.Text?.Length > 300 ? item.Text.Substring(0, 300) + "..." : item?.Text;
                            var formatted = preview.FormatWithSentenceBreaks();
                            <span title="@item?.Text">@((MarkupString)formatted)</span>
                        }
                    </Template>
                </GridColumn>
            </GridColumns>
        </TelerikGrid>

    <div class="mt-3 border rounded p-3 bg-light" style="min-height: 320px;">
        @if (SelectedDetail != null)
        {
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="mb-0">@SelectedDetail.FileName</h5>
                <TelerikButton OnClick="@(() => SelectedDetail = null)" Icon="@SvgIcon.X" Title="Close details" />
            </div>
            <DocumentDetails Document="@SelectedDetail" />
        }
        else
        {
            <div style="padding: 1rem;">
                <TelerikSkeleton ShapeType="@SkeletonShapeType.Text" Width="50%" Height="24px" Visible="true" />
                <div class="mt-3">
                    <TelerikSkeleton ShapeType="@SkeletonShapeType.Rectangle" Width="100%" Height="200px" Visible="true" />
                </div>
                <div class="mt-2 d-flex gap-3">
                    <TelerikSkeleton ShapeType="@SkeletonShapeType.Text" Width="30%" Height="16px" Visible="true" />
                    <TelerikSkeleton ShapeType="@SkeletonShapeType.Text" Width="40%" Height="16px" Visible="true" />
                </div>
                <div class="mt-3 text-center text-muted">
                    <em>Select a document row above to view details</em>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private string SearchQuery { get; set; } = "";
    private bool IsSearching { get; set; } = false;
    private bool ExactMatchOnly { get; set; } = false;
    private bool HasSearched { get; set; } = false;

    // Server-side paged grid state
    private List<SearchResultDto>? GridData { get; set; }
    private int TotalCount { get; set; }

    // Telerik grid reference for rebinding
    private TelerikGrid<SearchResultDto>? GridRef { get; set; }

    // DataSet filter
    private List<string> AvailableDataSets { get; set; } = new();
    private List<string> SelectedDataSets { get; set; } = new();
    
    // Names filter
    private List<string> AvailableNames { get; set; } = new();
    private List<string> SelectedNames { get; set; } = new();
    
    // Active filters for API queries (empty = all)
    private List<string>? ActiveDataSetFilter => 
        SelectedDataSets is { Count: > 0 } ? SelectedDataSets : null;
    private List<string>? ActiveNamesFilter => 
        SelectedNames is { Count: > 0 } ? SelectedNames : null;

    private SearchResultDto? SelectedDetail { get; set; }

    protected override async Task OnInitializedAsync()
    {
        AvailableDataSets = await SearchService.GetDataSetNamesAsync();
        // Grid will fire OnRead automatically on first render
    }

    /// <summary>
    /// Telerik Grid OnRead handler — fetches one page of data from the server.
    /// Called automatically on first render and when scrolling to new virtual pages.
    /// </summary>
    private async Task OnGridRead(GridReadEventArgs args)
    {
        var skip = args.Request.Skip;
        var take = args.Request.PageSize;

        try
        {
            IsSearching = true;
            StateHasChanged();

            var query = string.IsNullOrWhiteSpace(SearchQuery) ? null : SearchQuery;
            var result = await SearchService.SearchPagedAsync(
                query, skip, take, ExactMatchOnly,
                ActiveDataSetFilter, ActiveNamesFilter);

            args.Data = result.Items;
            args.Total = result.TotalCount;

            GridData = result.Items;
            TotalCount = result.TotalCount;
            HasSearched = true;

            // Update names dropdown from this page's results
            UpdateAvailableNames(result.Items);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"OnRead error: {ex.Message}");
            args.Data = new List<SearchResultDto>();
            args.Total = 0;
        }
        finally
        {
            IsSearching = false;
        }
    }

    /// <summary>
    /// Force the grid to re-read from the server (resets to page 0).
    /// </summary>
    private void RebindGrid()
    {
        GridRef?.Rebind();
    }

    private async Task OnDataSetFilterChanged()
    {
        RebindGrid();
        await Task.CompletedTask;
    }

    private void AddNameToFilter(string name)
    {
        if (!SelectedNames.Contains(name))
        {
            SelectedNames = new List<string>(SelectedNames) { name };
            if (!AvailableNames.Contains(name))
            {
                AvailableNames = new List<string>(AvailableNames) { name }.OrderBy(n => n).ToList();
            }
            StateHasChanged();
        }
    }

    private async Task OnNamesSearchClicked()
    {
        if (SelectedNames.Count == 0) return;
        RebindGrid();
        await Task.CompletedTask;
    }

    private void UpdateAvailableNames(List<SearchResultDto> pageItems)
    {
        var fromResults = pageItems
            .Where(r => r.Names != null)
            .SelectMany(r => r.Names!)
            .Distinct();
        var combined = new HashSet<string>(AvailableNames); // Keep existing
        foreach (var sp in SelectedNames) combined.Add(sp);
        foreach (var p in fromResults) combined.Add(p);
        AvailableNames = combined.OrderBy(n => n).ToList();
    }

    /// <summary>
    /// Returns badge CSS class: green for exact match in filter, yellow for partial match, blue otherwise.
    /// </summary>
    private string GetBadgeClass(string name)
    {
        if (SelectedNames.Count == 0) return "bg-info text-dark";
        if (SelectedNames.Any(sp => string.Equals(sp, name, StringComparison.OrdinalIgnoreCase)))
            return "bg-success";
        if (SelectedNames.Any(sp => name.Contains(sp, StringComparison.OrdinalIgnoreCase) || sp.Contains(name, StringComparison.OrdinalIgnoreCase)))
            return "bg-warning text-dark";
        return "bg-info text-dark";
    }

    private async Task PerformSearch()
    {
        RebindGrid();
        await Task.CompletedTask;
    }

    private void OnRowClick(GridRowClickEventArgs args)
    {
        var item = args.Item as SearchResultDto;
        SelectedDetail = (SelectedDetail == item) ? null : item;
    }
}

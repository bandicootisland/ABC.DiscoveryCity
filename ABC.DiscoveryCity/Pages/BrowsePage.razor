@page "/browse"
@using ABC.DiscoveryCity.Services
@using Telerik.Blazor
@using Telerik.Blazor.Components
@using Telerik.Blazor.Components.Common.Icon
@using static ABC.DiscoveryCity.Services.TextFormatExtensions
@inject SearchService SearchService
@inject UserListService UserListService
@inject NotificationService NotificationService
@inject IJSRuntime JS

<PageTitle>Browse Documents</PageTitle>

<div class="container-fluid">
    <h3>Browse Documents</h3>

    <div class="mb-3">
        <div class="input-group" style="max-width: 400px;">
            <TelerikTextBox @bind-Value="@_searchQuery" PlaceHolder="Filter documents..." Width="100%" />
            <TelerikButton OnClick="@OnSearch" Icon="@SvgIcon.Search">Search</TelerikButton>
            @if (!string.IsNullOrEmpty(_searchQuery))
            {
                <TelerikButton OnClick="@OnClear" Icon="@SvgIcon.X" Title="Clear" />
            }
        </div>
    </div>

    <TelerikContextMenu @ref="_contextMenu"
                        Data="@_contextMenuItems"
                        TextField="Text"
                        IconField="Icon"
                        SeparatorField="IsSeparator"
                        OnClick="@((ContextMenuItem item) => OnContextMenuClick(item))" />

    @if (_showQuickNewListDialog)
    {
        <TelerikDialog @bind-Visible="_showQuickNewListDialog" Title="New List" Width="350px">
            <DialogContent>
                <div class="mb-3">
                    <label class="form-label">List Name</label>
                    <input type="text" class="form-control" @bind="_quickNewListName" @bind:event="oninput" placeholder="Enter list name..." />
                </div>
                <p class="text-muted small">1 document will be added.</p>
            </DialogContent>
            <DialogButtons>
                <TelerikButton OnClick="@(() => _showQuickNewListDialog = false)">Cancel</TelerikButton>
                <TelerikButton OnClick="@SaveQuickNewList" ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                               Enabled="@(!string.IsNullOrWhiteSpace(_quickNewListName))">Save</TelerikButton>
            </DialogButtons>
        </TelerikDialog>
    }

    <TelerikSplitter Orientation="@SplitterOrientation.Horizontal" Height="calc(100vh - 170px)">
        <SplitterPanes>
            <SplitterPane Size="35%" Min="250px">
                <div class="browse-card-list" tabindex="0" @onkeydown="OnKeyDown" style="height: 100%; overflow-y: auto; padding: 8px; outline: none;">
                    @if (_documents == null)
                    {
                        <div class="d-flex justify-content-center p-4">
                            <TelerikLoader Visible="true" />
                        </div>
                    }
                    else if (_documents.Count == 0)
                    {
                        <div class="text-center text-muted p-4">No documents found.</div>
                    }
                    else
                    {
                        @foreach (var doc in _documents)
                        {
                            <div class="browse-card @(doc == _selectedDoc ? "selected" : "")"
                                 @onclick="@(() => SelectDocument(doc))"
                                 @oncontextmenu="@(e => OnCardContextMenu(e, doc))"
                                 @oncontextmenu:preventDefault>
                                <div class="d-flex gap-3">
                                    @if (!string.IsNullOrEmpty(doc.ThumbnailPath))
                                    {
                                        <img src="@($"{SearchService.ApiBaseUrl}/api/images/view?path={Uri.EscapeDataString(doc.ThumbnailPath)}")"
                                             class="browse-card-thumb" alt="" />
                                    }
                                    else
                                    {
                                        <div class="browse-card-thumb-placeholder">
                                            <TelerikIcon Icon="@GetFileIcon(doc.FileName)" />
                                        </div>
                                    }
                                    <div class="flex-grow-1 overflow-hidden">
                                        <div class="fw-bold text-truncate" title="@doc.FileName">@doc.FileName</div>
                                        <div class="text-muted small">
                                            @if (doc.Date != null)
                                            {
                                                <span title="Date deduced from document content">~@doc.Date.Value.ToString("yyyy-MM-dd")</span>
                                            }
                                            else
                                            {
                                                <span>Unknown date</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(doc.DataSetName))
                                        {
                                            <span class="badge mt-1" style="background: var(--kendo-subtle-text, #6c757d); color: var(--kendo-on-app-surface, #fff);">@doc.DataSetName</span>
                                        }
                                        @if (doc.Names is { Count: > 0 })
                                        {
                                            <div class="mt-1">
                                                @foreach (var name in doc.Names.Take(3))
                                                {
                                                    <span class="badge me-1" style="background: var(--kendo-info-bg, #0dcaf0); color: var(--kendo-info-text, #000);">@name</span>
                                                }
                                                @if (doc.Names.Count > 3)
                                                {
                                                    <span class="text-muted small">+@(doc.Names.Count - 3)</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                        @if (_hasMore)
                        {
                            <div class="text-center py-3">
                                <TelerikButton OnClick="@LoadMore" ThemeColor="@ThemeConstants.Button.ThemeColor.Primary">
                                    Load more
                                </TelerikButton>
                            </div>
                        }
                    }
                </div>
            </SplitterPane>
            <SplitterPane Min="300px">
                <div class="border rounded p-3" style="height: 100%; overflow-y: auto; background: var(--kendo-base-bg, #f8f9fa);">
                    @if (_selectedDoc != null)
                    {
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h5 class="mb-0">@_selectedDoc.FileName</h5>
                            <div class="d-flex gap-1">
                                @if (!string.IsNullOrEmpty(_selectedDoc.FilePath))
                                {
                                    <TelerikButton OnClick="@(() => DownloadFile(_selectedDoc))" Icon="@SvgIcon.Download" Title="Download" />
                                }
                                <TelerikSplitButton OnClick="@(() => QuickAddToLastList(_selectedDoc!))"
                                                    Icon="@SvgIcon.ListUnordered"
                                                    Size="@ThemeConstants.Button.Size.Small"
                                                    Title="Add to most recent list">
                                    <SplitButtonContent>Add to List</SplitButtonContent>
                                    <SplitButtonItems>
                                        @foreach (var list in RecentLists)
                                        {
                                            var capturedList = list;
                                            <SplitButtonItem OnClick="@(() => QuickAddToList(_selectedDoc!, capturedList))"
                                                             Icon="@SvgIcon.ListUnordered">@capturedList.Name</SplitButtonItem>
                                        }
                                        <SplitButtonItem OnClick="@(() => ShowQuickNewListDialog(_selectedDoc!))"
                                                         Icon="@SvgIcon.Plus">New List...</SplitButtonItem>
                                    </SplitButtonItems>
                                </TelerikSplitButton>
                                <TelerikButton OnClick="@(() => _selectedDoc = null)" Icon="@SvgIcon.X" Title="Close" />
                            </div>
                        </div>
                        <DocumentDetails Document="@_selectedDoc"
                                         @bind-ActiveTabIndex="_detailTabIndex"
                                         SearchQuery="@_searchQuery" />
                    }
                    else
                    {
                        <div class="text-center text-muted p-5">
                            <em>Select a document card to view details</em>
                        </div>
                    }
                </div>
            </SplitterPane>
        </SplitterPanes>
    </TelerikSplitter>
</div>

@code {
    private string _searchQuery = "";
    private List<SearchResultDto>? _documents;
    private SearchResultDto? _selectedDoc;
    private int _detailTabIndex;
    private int _loadedCount;
    private int _totalCount;
    private bool _hasMore;
    private const int PageSize = 50;

    // Context menu & quick add-to-list
    private TelerikContextMenu<ContextMenuItem>? _contextMenu;
    private SearchResultDto? _contextMenuTarget;
    private List<ContextMenuItem> _contextMenuItems = new();
    private bool _showQuickNewListDialog;
    private string _quickNewListName = "";
    private List<UserList> _availableLists = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDocuments(reset: true);
        _availableLists = await UserListService.GetAllAsync();
    }

    private async Task LoadDocuments(bool reset)
    {
        if (reset)
        {
            _loadedCount = 0;
            _documents = null;
            _selectedDoc = null;
        }

        var query = string.IsNullOrWhiteSpace(_searchQuery) ? null : _searchQuery;
        var result = await SearchService.SearchPagedAsync(query, _loadedCount, PageSize, exactMatch: true);

        if (reset)
            _documents = result.Items;
        else
            _documents!.AddRange(result.Items);

        _totalCount = result.TotalCount;
        _loadedCount = _documents.Count;
        _hasMore = _loadedCount < _totalCount;
    }

    private async Task OnSearch()
    {
        SearchService.ClearPageCache();
        await LoadDocuments(reset: true);
    }

    private async Task OnClear()
    {
        _searchQuery = "";
        SearchService.ClearPageCache();
        await LoadDocuments(reset: true);
    }

    private async Task LoadMore()
    {
        await LoadDocuments(reset: false);
    }

    private void SelectDocument(SearchResultDto doc)
    {
        _selectedDoc = doc;
        _detailTabIndex = 0;
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (_documents == null || _documents.Count == 0) return;

        var currentIndex = _selectedDoc != null ? _documents.IndexOf(_selectedDoc) : -1;
        
        if (e.Key == "ArrowDown" || e.Key == "ArrowUp")
        {
            var newIndex = e.Key == "ArrowDown"
                ? Math.Min(currentIndex + 1, _documents.Count - 1)
                : Math.Max(currentIndex - 1, 0);

            if (newIndex >= 0 && newIndex < _documents.Count)
            {
                SelectDocument(_documents[newIndex]);
                await JS.InvokeVoidAsync("scrollBrowseCardIntoView", newIndex);
            }
        }
    }

    private async Task DownloadFile(SearchResultDto doc)
    {
        var url = $"{SearchService.ApiBaseUrl}/api/images/view?path={Uri.EscapeDataString(doc.FilePath!)}";
        await JS.InvokeVoidAsync("triggerFileDownload", url, doc.FileName);
    }

    private static ISvgIcon GetFileIcon(string? fileName)
    {
        var ext = System.IO.Path.GetExtension(fileName ?? "").ToLowerInvariant();
        return ext switch
        {
            ".pdf" => SvgIcon.FilePdf,
            ".xlsx" or ".xls" or ".csv" => SvgIcon.FileExcel,
            ".avi" or ".mp4" or ".vob" or ".mov" or ".mkv" or ".wmv" => SvgIcon.FileVideo,
            ".m4a" or ".mp3" or ".wav" or ".aac" or ".ogg" or ".flac" => SvgIcon.FileAudio,
            _ => SvgIcon.File
        };
    }

    // --- Context menu & quick add-to-list ---

    private List<UserList> RecentLists =>
        _availableLists.OrderByDescending(l => l.ModifiedAt).Take(5).ToList();

    private async Task OnCardContextMenu(MouseEventArgs e, SearchResultDto doc)
    {
        _contextMenuTarget = doc;
        _contextMenuItems = BuildContextMenuItems();
        await _contextMenu!.ShowAsync(e.ClientX, e.ClientY);
    }

    private List<ContextMenuItem> BuildContextMenuItems()
    {
        var items = new List<ContextMenuItem>();
        var recent = RecentLists;
        foreach (var list in recent)
        {
            items.Add(new ContextMenuItem
            {
                Text = list.Name,
                Icon = SvgIcon.ListUnordered,
                ListId = list.Id
            });
        }
        if (recent.Count > 0)
            items.Add(new ContextMenuItem { IsSeparator = true });
        items.Add(new ContextMenuItem
        {
            Text = "New List...",
            Icon = SvgIcon.Plus,
            ListId = null
        });
        return items;
    }

    private async Task OnContextMenuClick(ContextMenuItem item)
    {
        if (item.IsSeparator || _contextMenuTarget == null) return;

        if (item.ListId != null)
            await QuickAddToList(_contextMenuTarget, (await UserListService.GetByIdAsync(item.ListId))!);
        else
            ShowQuickNewListDialog(_contextMenuTarget);
    }

    private async Task QuickAddToList(SearchResultDto doc, UserList targetList)
    {
        var source = UserListService.CreateFromSearchResults("_", null, new[] { doc });
        UserListService.Append(targetList, source);
        await UserListService.SaveAsync(targetList);
        _availableLists = await UserListService.GetAllAsync();
        NotificationService.ShowSuccess($"Added \"{doc.FileName}\" to \"{targetList.Name}\"");
    }

    private async Task QuickAddToLastList(SearchResultDto doc)
    {
        var last = RecentLists.FirstOrDefault();
        if (last != null)
            await QuickAddToList(doc, last);
        else
            ShowQuickNewListDialog(doc);
    }

    private void ShowQuickNewListDialog(SearchResultDto doc)
    {
        _contextMenuTarget = doc;
        _quickNewListName = "";
        _showQuickNewListDialog = true;
    }

    private async Task SaveQuickNewList()
    {
        if (string.IsNullOrWhiteSpace(_quickNewListName) || _contextMenuTarget == null) return;
        var list = UserListService.CreateFromSearchResults(_quickNewListName, null, new[] { _contextMenuTarget });
        await UserListService.SaveAsync(list);
        _availableLists = await UserListService.GetAllAsync();
        NotificationService.ShowSuccess($"Created list \"{_quickNewListName}\" with \"{_contextMenuTarget.FileName}\"");
        _showQuickNewListDialog = false;
        _quickNewListName = "";
    }

    private class ContextMenuItem
    {
        public string Text { get; set; } = "";
        public ISvgIcon? Icon { get; set; }
        public string? ListId { get; set; }
        public bool IsSeparator { get; set; }
    }
}

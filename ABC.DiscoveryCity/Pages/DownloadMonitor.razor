@page "/download-monitor"
@using System.IO
@using System.IO.Compression
@using ABC.DiscoveryCity.Services
@inject IJSRuntime JS

<h3>Download Monitor</h3>

<div class="card mb-3">
    <div class="card-body">
        <div class="row align-items-center">
            <div class="col-auto">
                <button class="btn btn-primary" @onclick="SelectFolder">
                    <span class="oi oi-folder"></span> Select Download Folder
                </button>
            </div>
            <div class="col">
                @if (!string.IsNullOrEmpty(selectedFolder))
                {
                    <span class="text-success fw-bold">Selected: @selectedFolder</span>
                }
                else
                {
                    <span class="text-muted">Please select the folder where torrents are downloading (e.g. H:\BookCity\Books\aa_derived_mirror_metadata_20251121\mariadb)</span>
                }
            </div>
            <div class="col-auto">
                <button class="btn btn-success" @onclick="CheckProgress" disabled="@(!files.Any())">
                    <span class="oi oi-loop-circular"></span> Check Progress
                </button>
            </div>
        </div>
    </div>
</div>

@if (files.Any())
{
    <TelerikGrid Data="@files"
                 Pageable="true"
                 Sortable="true"
                 FilterMode="@GridFilterMode.FilterMenu"
                 Resizable="true"
                 SelectionMode="@GridSelectionMode.Multiple"
                 @bind-SelectedItems="@selectedFiles">
        <GridToolBarTemplate>
            <span class="k-toolbar-spacer"></span>
            <GridSearchBox />
        </GridToolBarTemplate>
        <GridColumns>
            <GridCheckboxColumn SelectAll="true" Width="50px" />
            <GridColumn Field="@nameof(FileModel.Name)" Title="File Name" />
            <GridColumn Field="@nameof(FileModel.Size)" Title="Size" Width="150px">
                <Template>
                    @{
                        var file = context as FileModel;
                        <span>@(file.Size / 1024 / 1024) MB</span>
                    }
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(FileModel.Status)" Title="Status" Width="250px">
                <Template>
                    @{
                        var file = context as FileModel;
                        <span class="@GetStatusClass(file.Status)">@file.Status</span>
                    }
                </Template>
            </GridColumn>
            <GridColumn Title="Actions" Width="120px">
                <Template>
                    @{
                        var file = context as FileModel;
                        <TelerikButton Icon="@SvgIcon.Search" 
                                     OnClick="@(() => InspectFile(file))" 
                                     Enabled="@(file.Status.Contains("Ready") || file.Status.Contains("Partial"))">
                            Inspect
                        </TelerikButton>
                    }
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(FileModel.LastChecked)" Title="Last Checked" Width="180px" DisplayFormat="{0:HH:mm:ss}" />
        </GridColumns>
    </TelerikGrid>
}

<TelerikWindow @bind-Visible="@isInspectorVisible" Modal="true" Width="800px" Height="600px">
    <WindowTitle>
        <strong>Inspecting: @inspectingFileName</strong>
    </WindowTitle>
    <WindowContent>
        @if (inspectorLoading)
        {
            <div class="d-flex align-items-center justify-content-center h-100">
                <div class="spinner-border text-primary me-3" role="status"></div>
                <span>Reading and Decompressing...</span>
            </div>
        }
        else
        {
            <div class="d-flex flex-column h-100">
                <div class="alert alert-info py-1 mb-2 flex-shrink-0">
                    Showing first 20 lines of the file.
                </div>
                <div class="card flex-grow-1" style="overflow: auto; min-height: 0;">
                    <div class="card-body bg-light">
                        <pre style="white-space: pre-wrap; font-size: 0.85rem;">
@foreach (var line in inspectorLines)
{
@line
<hr class="my-1"/>
}
                        </pre>
                    </div>
                </div>
                <div class="mt-2 flex-shrink-0">
                    <strong>End of File Check:</strong>
                    <div class="alert @footerClass mb-0 py-2">
                        @footerMessage
                        @if(!string.IsNullOrEmpty(footerHex))
                        {
                            <div class="small font-monospace mt-1">Last 32 Bytes: @footerHex</div>
                        }
                    </div>
                </div>
            </div>
        }
    </WindowContent>
    <WindowActions>
        <WindowAction Name="Close" />
    </WindowActions>
</TelerikWindow>

@code {
    private string selectedFolder = "";
    private List<FileModel> files = new();
    private IEnumerable<FileModel> selectedFiles = new List<FileModel>();
    
    // Inspector State
    private bool isInspectorVisible = false;
    private string inspectingFileName = "";
    private bool inspectorLoading = false;
    private List<string> inspectorLines = new();
    private string footerMessage = "";
    private string footerClass = "alert-secondary";
    private string footerHex = "";

    private async Task SelectFolder()
    {
        selectedFolder = await JS.InvokeAsync<string>("fileSystem.selectDirectory");
        if (!string.IsNullOrEmpty(selectedFolder))
        {
            await LoadFiles();
        }
    }

    private async Task LoadFiles()
    {
        var rawFiles = await JS.InvokeAsync<List<FileDto>>("fileSystem.listFiles");
        files = rawFiles.Select(f => new FileModel
        {
            Name = f.Name,
            Size = f.Size,
            LastModified = f.LastModified,
            Status = "Unknown"
        }).OrderBy(f => f.Name).ToList();
        
        selectedFiles = files.Where(f => f.Name.EndsWith(".gz")).ToList();
    }

    private async Task CheckProgress()
    {
        foreach (var file in selectedFiles)
        {
            file.Status = "Checking...";
            StateHasChanged();

            try
            {
                // 1. Check Header (First 1KB)
                var headerBytes = await JS.InvokeAsync<byte[]>("fileSystem.readFileChunk", file.Name, 0, 1024);
                
                // 2. Check Footer (Last 1KB) - to see if file is fully downloaded
                // Note: This is just a heuristic. BitTorrent can download end pieces before middle pieces.
                var footerBytes = await JS.InvokeAsync<byte[]>("fileSystem.readFileChunk", file.Name, -1024, 1024);

                if (headerBytes == null || headerBytes.Length == 0)
                {
                    file.Status = "Error Reading";
                }
                else
                {
                    bool isHeaderZeros = IsAllZeros(headerBytes);
                    bool isFooterZeros = IsAllZeros(footerBytes);

                    if (isHeaderZeros)
                    {
                        file.Status = "Pending (0%)";
                    }
                    else
                    {
                        // Header is present
                        string type = "Raw";
                        if (headerBytes.Length >= 2 && headerBytes[0] == 0x1F && headerBytes[1] == 0x8B)
                        {
                            type = "GZIP";
                        }

                        if (isFooterZeros)
                        {
                            file.Status = $"Partial (Header Only) - {type}";
                        }
                        else
                        {
                            // Both start and end have data. Likely complete or mostly complete.
                            file.Status = $"Ready/Downloading - {type}";
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                file.Status = $"Error: {ex.Message}";
            }
            
            file.LastChecked = DateTime.Now;
            StateHasChanged();
        }
    }

    private bool IsAllZeros(byte[] bytes)
    {
        if (bytes == null || bytes.Length == 0) return true;
        foreach (var b in bytes) if (b != 0) return false;
        return true;
    }

    private async Task InspectFile(FileModel file)
    {
        inspectingFileName = file.Name;
        isInspectorVisible = true;
        inspectorLoading = true;
        inspectorLines.Clear();
        footerMessage = "";
        footerHex = "";
        StateHasChanged();

        try
        {
            // Read first 64KB for inspection
            var chunk = await JS.InvokeAsync<byte[]>("fileSystem.readFileChunk", file.Name, 0, 64 * 1024);
            
            // Read last 1KB for footer inspection
            var footerChunk = await JS.InvokeAsync<byte[]>("fileSystem.readFileChunk", file.Name, -1024, 1024);
            
            if (footerChunk != null && footerChunk.Length > 0)
            {
                if (IsAllZeros(footerChunk))
                {
                    footerMessage = "The end of the file is all Zeros (0x00). Download is incomplete.";
                    footerClass = "alert-danger";
                }
                else
                {
                    footerMessage = "The end of the file contains data. Note: BitTorrent downloads non-sequentially, so the middle of the file may still be missing (Sparse File). Check the Downloader % to be sure.";
                    footerClass = "alert-warning";
                    int len = Math.Min(32, footerChunk.Length);
                    var lastBytes = new byte[len];
                    Array.Copy(footerChunk, footerChunk.Length - len, lastBytes, 0, len);
                    footerHex = BitConverter.ToString(lastBytes);
                }
            }
            else
            {
                footerMessage = "Could not read file footer.";
                footerClass = "alert-warning";
            }

            if (chunk == null || chunk.Length == 0)
            {
                inspectorLines.Add("Error: Could not read file chunk.");
            }
            else if (IsAllZeros(chunk))
            {
                inspectorLines.Add("File is empty (all zeros). Download has not started for this file.");
            }
            else
            {
                // Try GZIP
                try 
                {
                    using var memStream = new MemoryStream(chunk);
                    using var gzipStream = new GZipStream(memStream, CompressionMode.Decompress);
                    using var reader = new StreamReader(gzipStream);
                    
                    for(int i=0; i<20; i++) 
                    {
                        var line = await reader.ReadLineAsync();
                        if(line == null) break;
                        inspectorLines.Add(line);
                    }
                }
                catch
                {
                    // Fallback to text
                    inspectorLines.Add("GZIP Decompression failed. Showing raw text:");
                    string text = System.Text.Encoding.UTF8.GetString(chunk, 0, Math.Min(chunk.Length, 1000));
                    text = new string(text.Where(c => !char.IsControl(c) || c == '\n' || c == '\r' || c == '\t').ToArray());
                    inspectorLines.Add(text);
                }
            }
        }
        catch (Exception ex)
        {
            inspectorLines.Add($"Error: {ex.Message}");
        }
        finally
        {
            inspectorLoading = false;
            StateHasChanged();
        }
    }

    private string GetStatusClass(string status)
    {
        if (status.Contains("Pending")) return "text-danger fw-bold";
        if (status.Contains("Ready")) return "text-success fw-bold";
        if (status.Contains("Partial")) return "text-warning fw-bold";
        if (status.Contains("Checking")) return "text-info";
        return "text-secondary";
    }

    public class FileModel
    {
        public string Name { get; set; }
        public long Size { get; set; }
        public long LastModified { get; set; }
        public string Status { get; set; }
        public DateTime? LastChecked { get; set; }
    }

    public class FileDto
    {
        public string Name { get; set; }
        public long Size { get; set; }
        public long LastModified { get; set; }
    }
}

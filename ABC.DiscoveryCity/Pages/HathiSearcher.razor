@page "/hathi-searcher"
@page "/hathi-searcher/{Htid}"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

<h3>🔎 Hathi Searcher</h3>

@if (errorMessage != null)
{
    <div class="alert alert-danger alert-dismissible">
        @errorMessage
        <button type="button" class="btn-close" @onclick="@(() => errorMessage = null)"></button>
    </div>
}

@if (Htid == null)
{    
    @if (_pageStateReady)
    {
        <TelerikGrid @ref="@_gridRef"
                     TItem="HathiCatalogItem"
                     OnRead="@ReadItems"
                     Pageable="true"
                     PageSize="@pageSize"
                     PageSizeChanged="@OnPageSizeChanged"
                     @bind-Page="@currentPage"
                     Sortable="true"
                     FilterMode="@GridFilterMode.FilterRow"
                     Resizable="true"
                     Height="100vh"
                     OnRowExpand="@OnRowExpand"
                     OnStateInit="@OnGridStateInit">
            <GridSettings>
                <GridPagerSettings InputType="PagerInputType.Input"
                                   PageSizes="@(new List<int?> { 25, 50, 100, 200 })"
                                   ButtonCount="5"
                                   Position="PagerPosition.Top" />
            </GridSettings>
            <DetailTemplate>
                @{
                    var book = (HathiCatalogItem)context;
                    var iframeSrc = expandedHtids.Contains(book.Htid) ? GetHathiTrustEmbedUrl(book.Htid) : "about:blank";
                }
                <div class="p-2" style="background-color: #f8f9fa;">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div>
                            <strong>@book.Title</strong>
                            @if (!string.IsNullOrEmpty(book.Author))
                            {
                                <span class="text-muted ms-2">by @book.Author</span>
                            }
                        </div>
                        <div>
                            <a href="@GetHathiTrustUrl(book.Htid)" target="_blank" class="btn btn-sm btn-outline-primary">
                                Open in New Window 🔗
                            </a>
                        </div>
                    </div>
                    @if (book.Access == "allow")
                    {
                        <iframe src="@iframeSrc" 
                                style="width: 100%; height: 100vh; min-height: 800px; border: 1px solid #ddd; border-radius: 4px;"
                                loading="lazy"
                                allow="storage-access"
                                title="HathiTrust Viewer - @book.Title">
                        </iframe>
                        <div class="mt-2 text-end">
                            <a href="@GetHathiTrustUrl(book.Htid)" target="_blank" class="btn btn-sm btn-outline-secondary">
                                Open in New Window 🔗
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-0">
                            <strong>Limited Access:</strong> This item may require institutional login or have viewing restrictions.
                            <a href="@GetHathiTrustUrl(book.Htid)" target="_blank">View on HathiTrust</a> to check access options.
                        </div>
                    }
                </div>
            </DetailTemplate>
            <GridToolBarTemplate>
                <TelerikTextBox @bind-Value="@_searchBoxValue"
                                Placeholder="Search..."
                                Width="300px"
                                DebounceDelay="500"
                                OnChange="@OnSearchBoxChanged" />
                <span class="k-toolbar-spacer"></span>
                @if (summary != null)
                {
                    <span class="badge bg-primary">@summary.TotalRecords.ToString("N0") total</span>
                    <span class="badge bg-success">@summary.PublicAccess.ToString("N0") public</span>
                    <span class="badge bg-info">@summary.UniqueLanguages langs</span>
                }
                <span class="text-muted small ms-2">Showing: @totalCount.ToString("N0")</span>
            </GridToolBarTemplate>
            <GridColumns>
                <GridColumn Field="@nameof(HathiCatalogItem.Title)" Title="Title" Width="350px" Sortable="true">
                    <Template>
                        @{
                            var book = (HathiCatalogItem)context;
                        }
                        <strong>@(TruncateText(book.Title, 80) ?? "(No title)")</strong>
                        <br /><small class="text-muted">@book.Htid</small>
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(HathiCatalogItem.Author)" Title="Author" Width="200px" Sortable="true">
                    <Template>
                        @{
                            var book = (HathiCatalogItem)context;
                        }
                        @TruncateText(book.Author, 40)
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(HathiCatalogItem.Lang)" Title="Lang" Width="70px" />
                <GridColumn Field="@nameof(HathiCatalogItem.RightsDateUsed)" Title="Date" Width="80px" />
                <GridColumn Field="@nameof(HathiCatalogItem.Access)" Title="Access" Width="100px">
                    <Template>
                        @{
                            var book = (HathiCatalogItem)context;
                        }
                        @if (book.Access == "allow")
                        {
                            <span class="badge bg-success">Public</span>
                        }
                        else if (book.Access == "deny")
                        {
                            <span class="badge bg-warning text-dark">Limited</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@(book.Access ?? "?")</span>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(HathiCatalogItem.Rights)" Title="Rights" Width="100px" />
                <GridColumn Field="@nameof(HathiCatalogItem.Source)" Title="Source" Width="100px" />
                <GridColumn Title="IDs" Width="120px">
                    <Template>
                        @{
                            var book = (HathiCatalogItem)context;
                        }
                        @if (!string.IsNullOrEmpty(book.Isbn))
                        {
                            <small>ISBN: @TruncateText(book.Isbn, 15)</small><br/>
                        }
                        @if (!string.IsNullOrEmpty(book.OclcNum))
                        {
                            <small>OCLC: @TruncateText(book.OclcNum, 15)</small>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Title="Actions" Width="180px" Filterable="false" Sortable="false">
                    <Template>
                        @{
                            var book = (HathiCatalogItem)context;
                        }
                        @if (IsInLibrary(book.Htid))
                        {
                            <TelerikButton OnClick="@(() => RemoveFromLibrary(book))" Size="@ThemeConstants.Button.Size.Small" ThemeColor="@ThemeConstants.Button.ThemeColor.Success" title="In My Library">
                                ❤️
                            </TelerikButton>
                        }
                        else
                        {
                            <TelerikButton OnClick="@(() => AddToLibrary(book))" Size="@ThemeConstants.Button.Size.Small" ThemeColor="@ThemeConstants.Button.ThemeColor.Light" title="Add to My Library">
                                🤍
                            </TelerikButton>
                        }
                        <a href="@GetHathiTrustUrl(book.Htid)" target="_blank" class="k-button k-button-sm k-button-outline k-button-outline-base ms-1" title="View in HathiTrust">
                            🔗
                        </a>
                        <a href="@GetHathiTrustCatalogUrl(book.HtBibKey)" target="_blank" class="k-button k-button-sm k-button-outline k-button-outline-base ms-1" title="View Catalog Record">
                            📚
                        </a>
                    </Template>
                </GridColumn>
            </GridColumns>
        </TelerikGrid>
    }
}
else
{
    <!-- Single Book Reader View -->
    @if (bookInfo != null)
    {
        <div class="mb-3 d-flex gap-2">
            <TelerikButton OnClick="@BackToList" Icon="@SvgIcon.ArrowLeft">Back to List</TelerikButton>
            
            @if (IsInLibrary(bookInfo.Htid))
            {
                <TelerikButton OnClick="@(() => RemoveFromLibraryReader())" ThemeColor="@ThemeConstants.Button.ThemeColor.Success">
                    ❤️ In My Library
                </TelerikButton>
            }
            else
            {
                <TelerikButton OnClick="@(() => AddToLibraryReader())" ThemeColor="@ThemeConstants.Button.ThemeColor.Light">
                    🤍 Add to My Library
                </TelerikButton>
            }
            
            @if (bookInfo.Access == "allow")
            {
                <a href="@GetPdfDownloadUrl(bookInfo.Htid)" target="_blank" class="btn btn-outline-success">
                    📥 Download PDF
                </a>
            }
        </div>

        <div class="card mb-3">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-0">@(bookInfo.Title ?? "(No title)")</h5>
                    @if (bookInfo.Author != null)
                    {
                        <small>by @bookInfo.Author</small>
                    }
                </div>
                <div class="d-flex gap-2">
                    @if (bookInfo.Access == "allow")
                    {
                        <span class="badge bg-success align-self-center">Public Domain</span>
                    }
                    <a href="@GetHathiTrustUrl(bookInfo.Htid)" target="_blank" class="btn btn-light btn-sm">
                        🔗 View on HathiTrust
                    </a>
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <dl class="row mb-0">
                            <dt class="col-sm-4">HTID</dt>
                            <dd class="col-sm-8"><code>@bookInfo.Htid</code></dd>
                            
                            <dt class="col-sm-4">Language</dt>
                            <dd class="col-sm-8">@(bookInfo.Lang ?? "-")</dd>
                            
                            <dt class="col-sm-4">Access</dt>
                            <dd class="col-sm-8">
                                @if (bookInfo.Access == "allow")
                                {
                                    <span class="badge bg-success">Public</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Restricted</span>
                                }
                                @bookInfo.Rights
                            </dd>
                            
                            <dt class="col-sm-4">Date</dt>
                            <dd class="col-sm-8">@(bookInfo.RightsDateUsed ?? "-")</dd>
                        </dl>
                    </div>
                    <div class="col-md-6">
                        <dl class="row mb-0">
                            <dt class="col-sm-4">ISBN</dt>
                            <dd class="col-sm-8">@(bookInfo.Isbn ?? "-")</dd>
                            
                            <dt class="col-sm-4">OCLC</dt>
                            <dd class="col-sm-8">@(bookInfo.OclcNum ?? "-")</dd>
                            
                            <dt class="col-sm-4">LCCN</dt>
                            <dd class="col-sm-8">@(bookInfo.Lccn ?? "-")</dd>
                            
                            <dt class="col-sm-4">Source</dt>
                            <dd class="col-sm-8">@(bookInfo.Source ?? "-")</dd>
                        </dl>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(bookInfo.Imprint))
                {
                    <div class="mt-2">
                        <strong>Imprint:</strong> @bookInfo.Imprint
                    </div>
                }
                @if (!string.IsNullOrEmpty(bookInfo.Description))
                {
                    <div class="mt-2">
                        <strong>Description:</strong> @bookInfo.Description
                    </div>
                }
            </div>
        </div>

        <!-- HathiTrust Embedded Viewer -->
        <div class="card">
            <div class="card-header">
                <span>HathiTrust Reader</span>
            </div>
            <div class="card-body p-0">
                <iframe src="@GetHathiTrustEmbedUrl(bookInfo.Htid)" 
                        style="width: 100%; height: 700px; border: none;"
                        title="HathiTrust Book Reader">
                </iframe>
            </div>
        </div>
    }
}

@code {
    private const string PageStateStorageKey = "pageState:hathi-searcher";

    private CancellationTokenSource? _readItemsCts;
    private List<HathiCatalogItem> _lastGridItems = new();
    private int _lastGridTotal;
    private long _lastTotalCount;
    private TelerikGrid<HathiCatalogItem>? _gridRef;
    private string _searchBoxValue = "";
    
    [Parameter]
    public string? Htid { get; set; }

    private HathiCatalogSummary? summary;
    private HathiCatalogItem? bookInfo;
    private long totalCount = 0;
    private int currentPage = 1;
    private int pageSize = 50;
    private bool _pageStateReady;
    private string _persistedSearchTerm = "";
    private string _persistedRightsFilter = "";
    private string? _persistedSortField;
    private string _persistedSortDir = "asc";
    private HashSet<string> expandedHtids = new(); // Track which rows are expanded to lazy-load iframes
    private HashSet<string> libraryHtids = new(); // Track which books are in the user's library

    private bool loading = false;
    private string? errorMessage;

    private async Task OnSearchBoxChanged(object? value)
    {
        _persistedSearchTerm = _searchBoxValue?.Trim() ?? "";
        currentPage = 1; // Reset to first page on new search
        await SavePageStateAsync();
        _gridRef?.Rebind();
    }

    private sealed class HathiSearcherPageState
    {
        public int Page { get; set; } = 1;
        public int PageSize { get; set; } = 50;
        public string SearchTerm { get; set; } = "";
        public string Rights { get; set; } = "";
        public string? SortField { get; set; }
        public string SortDir { get; set; } = "asc";
    }

    private async Task RestorePageStateAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("pageState.get", PageStateStorageKey);
            if (string.IsNullOrWhiteSpace(json)) return;

            var state = System.Text.Json.JsonSerializer.Deserialize<HathiSearcherPageState>(json);
            if (state == null) return;

            if (state.PageSize > 0) pageSize = state.PageSize;
            if (state.Page > 0) currentPage = state.Page;

            _persistedSearchTerm = state.SearchTerm ?? "";
            _searchBoxValue = _persistedSearchTerm; // Restore into the visible search box
            _persistedRightsFilter = state.Rights ?? "";
            _persistedSortField = state.SortField;
            _persistedSortDir = string.Equals(state.SortDir, "desc", StringComparison.OrdinalIgnoreCase) ? "desc" : "asc";
        }
        catch
        {
            // Ignore localStorage/JSON errors and keep defaults.
        }
    }

    private async Task SavePageStateAsync()
    {
        try
        {
            // Only persist search term if >= 3 chars (user's requirement)
            var searchToSave = (_persistedSearchTerm ?? "").Trim();
            if (searchToSave.Length < 3) searchToSave = "";

            var state = new HathiSearcherPageState
            {
                Page = currentPage < 1 ? 1 : currentPage,
                PageSize = pageSize < 1 ? 50 : pageSize,
                SearchTerm = searchToSave,
                Rights = _persistedRightsFilter ?? "",
                SortField = _persistedSortField,
                SortDir = _persistedSortDir ?? "asc"
            };

            var json = System.Text.Json.JsonSerializer.Serialize(state);
            await JS.InvokeVoidAsync("pageState.set", PageStateStorageKey, json);
        }
        catch
        {
            // Ignore localStorage errors.
        }
    }

    private void OnPageSizeChanged(int newPageSize)
    {
        if (newPageSize < 1) return;
        pageSize = newPageSize;
        _ = SavePageStateAsync();
    }

    private void OnRowExpand(GridRowExpandEventArgs args)
    {
        var book = (HathiCatalogItem)args.Item;
        expandedHtids.Add(book.Htid);
    }

    private void OnGridStateInit(GridStateEventArgs<HathiCatalogItem> args)
    {
        args.GridState.Page = currentPage;

        var filters = new List<Telerik.DataSource.IFilterDescriptor>();

        // Note: We don't restore search term into grid filters because GridSearchBox is a separate
        // UI component that can't be programmatically set via OnStateInit. The search term is still
        // passed to the API via _persistedSearchTerm in ReadItems.

        var rights = (_persistedRightsFilter ?? string.Empty).Trim();
        if (!string.IsNullOrEmpty(rights))
        {
            filters.Add(new Telerik.DataSource.FilterDescriptor
            {
                Member = nameof(HathiCatalogItem.Rights),
                Operator = Telerik.DataSource.FilterOperator.Contains,
                Value = rights
            });
        }

        if (filters.Count > 0)
        {
            args.GridState.FilterDescriptors = filters;
        }

        if (!string.IsNullOrWhiteSpace(_persistedSortField))
        {
            args.GridState.SortDescriptors = new List<Telerik.DataSource.SortDescriptor>
            {
                new Telerik.DataSource.SortDescriptor
                {
                    Member = _persistedSortField,
                    SortDirection = string.Equals(_persistedSortDir, "desc", StringComparison.OrdinalIgnoreCase)
                        ? Telerik.DataSource.ListSortDirection.Descending
                        : Telerik.DataSource.ListSortDirection.Ascending
                }
            };
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RestorePageStateAsync();
            _pageStateReady = true;
            await LoadLibraryState();
            StateHasChanged();
        }
    }

    private async Task LoadLibraryState()
    {
        try
        {
            var books = await JS.InvokeAsync<List<LibraryBookDto>>("myLibrary.getAllBooks");
            libraryHtids = books?.Select(b => b.Htid).ToHashSet() ?? new HashSet<string>();
        }
        catch
        {
            // IndexedDB not available or error - continue without library state
        }
    }

    private bool IsInLibrary(string htid) => libraryHtids.Contains(htid);

    private async Task AddToLibrary(HathiCatalogItem book)
    {
        try
        {
            var libraryBook = new
            {
                htid = book.Htid,
                title = book.Title,
                author = book.Author,
                access = book.Access,
                rights = book.Rights,
                lang = book.Lang,
                rightsDateUsed = book.RightsDateUsed,
                htBibKey = book.HtBibKey,
                isbn = book.Isbn,
                oclcNum = book.OclcNum
            };
            await JS.InvokeVoidAsync("myLibrary.addBook", libraryBook);
            libraryHtids.Add(book.Htid);
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to add to library: {ex.Message}";
        }
    }

    private async Task RemoveFromLibrary(HathiCatalogItem book)
    {
        try
        {
            await JS.InvokeVoidAsync("myLibrary.removeBook", book.Htid);
            libraryHtids.Remove(book.Htid);
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to remove from library: {ex.Message}";
        }
    }

    private async Task AddToLibraryReader()
    {
        if (bookInfo == null) return;
        await AddToLibrary(bookInfo);
    }

    private async Task RemoveFromLibraryReader()
    {
        if (bookInfo == null) return;
        await RemoveFromLibrary(bookInfo);
    }

    private class LibraryBookDto
    {
        public string Htid { get; set; } = "";
    }

    protected override async Task OnInitializedAsync()
    {
        await RestorePageStateAsync();
        if (!string.IsNullOrEmpty(Htid))
        {
            await LoadBookInfo();
        }
        else
        {
            await RefreshSummary();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(Htid) && (bookInfo == null || bookInfo.Htid != Htid))
        {
            await LoadBookInfo();
        }
        else if (string.IsNullOrEmpty(Htid))
        {
            await RestorePageStateAsync();
        }
    }

    private async Task ReadItems(GridReadEventArgs args)
    {
        try
        {
            _readItemsCts?.Cancel();
            _readItemsCts?.Dispose();
            _readItemsCts = new CancellationTokenSource();
            var cancellationToken = _readItemsCts.Token;

            var page = args.Request.Page;
            var requestedPageSize = args.Request.PageSize;
            if (requestedPageSize > 0 && requestedPageSize != pageSize)
            {
                pageSize = requestedPageSize;
            }

            currentPage = page;
            
            // Use our custom search box value (not extracted from grid filters)
            var searchTerm = (_persistedSearchTerm ?? "").Trim();
            
            // Extract rights filter from grid FilterRow
            var rightsFilter = "";
            if (args.Request.Filters != null)
            {
                foreach (var filter in args.Request.Filters)
                {
                    if (filter is Telerik.DataSource.FilterDescriptor single && single.Value != null)
                    {
                        // FilterRow (single-field filters)
                        if (string.Equals(single.Member, nameof(HathiCatalogItem.Rights), StringComparison.OrdinalIgnoreCase))
                        {
                            rightsFilter = single.Value.ToString() ?? "";
                        }
                    }
                }
            }

            rightsFilter = rightsFilter?.Trim() ?? "";
            _persistedRightsFilter = rightsFilter;

            _persistedSortField = null;
            _persistedSortDir = "asc";
            if (args.Request.Sorts != null && args.Request.Sorts.Count > 0)
            {
                var firstSort = args.Request.Sorts[0];
                if (!string.IsNullOrWhiteSpace(firstSort.Member))
                {
                    _persistedSortField = firstSort.Member;
                    _persistedSortDir = firstSort.SortDirection == Telerik.DataSource.ListSortDirection.Descending ? "desc" : "asc";
                }
            }

            await SavePageStateAsync();

            if (!string.IsNullOrEmpty(searchTerm) && searchTerm.Length < 3)
            {
                // Keep the grid stable by returning the last successful page.
                args.Data = _lastGridItems;
                args.Total = _lastGridTotal;
                totalCount = _lastTotalCount;
                return;
            }
            
            var url = $"api/hathisearch?page={page}&pageSize={pageSize}";
            if (!string.IsNullOrEmpty(searchTerm))
            {
                url += $"&search={Uri.EscapeDataString(searchTerm)}";
            }
            if (!string.IsNullOrEmpty(rightsFilter))
            {
                url += $"&rights={Uri.EscapeDataString(rightsFilter)}";
            }

            if (args.Request.Sorts != null && args.Request.Sorts.Count > 0)
            {
                var sort = args.Request.Sorts[0];
                if (!string.IsNullOrWhiteSpace(sort.Member))
                {
                    url += $"&sortField={Uri.EscapeDataString(sort.Member)}";
                    url += $"&sortDir={(sort.SortDirection == Telerik.DataSource.ListSortDirection.Descending ? "desc" : "asc")}";
                }
            }
            
            var response = await Http.GetAsync(url, cancellationToken);
            var rawContent = await response.Content.ReadAsStringAsync();            
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = $"API returned {response.StatusCode}: {rawContent.Substring(0, Math.Min(200, rawContent.Length))}";
                args.Data = new List<HathiCatalogItem>();
                args.Total = 0;
                return;
            }
            
            var options = new System.Text.Json.JsonSerializerOptions 
            { 
                PropertyNameCaseInsensitive = true 
            };
            var result = System.Text.Json.JsonSerializer.Deserialize<PagedHathiResult>(rawContent, options);
            
            if (result != null)
            {
                args.Data = result.Items;
                args.Total = (int)Math.Min(result.TotalCount, int.MaxValue);
                totalCount = result.TotalCount;
                errorMessage = null;

                // Cache for stability when user types short searches.
                _lastGridItems = result.Items ?? new List<HathiCatalogItem>();
                _lastGridTotal = args.Total;
                _lastTotalCount = totalCount;
            }
        }
        catch (OperationCanceledException)
        {
            // Ignore: user typed/filtered again and we cancelled the previous request.
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load books: {ex.Message}";
            args.Data = new List<HathiCatalogItem>();
            args.Total = 0;
        }
    }

    private async Task RefreshSummary()
    {
        try
        {
            summary = await Http.GetFromJsonAsync<HathiCatalogSummary>("api/hathisearch/summary");
        }
        catch { }
    }

    private async Task LoadBookInfo()
    {
        if (string.IsNullOrEmpty(Htid)) return;
        
        loading = true;
        errorMessage = null;
        try
        {
            bookInfo = await Http.GetFromJsonAsync<HathiCatalogItem>($"api/hathisearch/{Uri.EscapeDataString(Htid)}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load book: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private void OpenReader(string htid)
    {
        Navigation.NavigateTo($"/hathi-searcher/{Uri.EscapeDataString(htid)}");
    }

    private void BackToList()
    {
        Navigation.NavigateTo("/hathi-searcher");
    }

    private static string GetHathiTrustUrl(string htid)
    {
        // HathiTrust item page URL
        return $"https://babel.hathitrust.org/cgi/pt?id={Uri.EscapeDataString(htid)}";
    }

    private static string GetHathiTrustCatalogUrl(long? htBibKey)
    {
        // HathiTrust catalog record URL (shows all volumes/editions)
        if (htBibKey == null) return "#";
        return $"https://catalog.hathitrust.org/Record/{htBibKey}";
    }

    private static string GetHathiTrustEmbedUrl(string htid)
    {
        // HathiTrust embedded viewer URL
        return $"https://babel.hathitrust.org/cgi/pt?id={Uri.EscapeDataString(htid)}&view=1up&seq=1";
    }

    private static string GetPdfDownloadUrl(string htid)
    {
        // HathiTrust PDF download page (for public domain books)
        return $"https://babel.hathitrust.org/cgi/pt?id={Uri.EscapeDataString(htid)}&view=plaintext";
    }

    private static string? TruncateText(string? text, int maxLength)
    {
        if (string.IsNullOrEmpty(text)) return text;
        return text.Length <= maxLength ? text : text.Substring(0, maxLength) + "...";
    }

    // DTOs
    public class HathiCatalogItem
    {
        public string Htid { get; set; } = "";
        public string? Access { get; set; }
        public string? Rights { get; set; }
        public long? HtBibKey { get; set; }
        public string? Description { get; set; }

@inherits LayoutComponentBase
@using ABC.DiscoveryCity.Services
@using Telerik.Blazor
@using Telerik.Blazor.Components
@inject NotificationService NotificationService
@inject ThemeService ThemeService
@implements IDisposable

<div class="page">
    <header class="top-bar">
        <a class="top-bar-brand" href="">Discovery City</a>
        <nav class="top-bar-nav">
            <NavLink class="top-bar-link" href="search" Match="NavLinkMatch.All">Search</NavLink>
            <NavLink class="top-bar-link" href="semantic-search">Semantic</NavLink>
            <NavLink class="top-bar-link" href="browse">Browse</NavLink>
            <NavLink class="top-bar-link" href="lists">Lists</NavLink>
            <NavLink class="top-bar-link" href="workspace">Workspace</NavLink>
            <NavLink class="top-bar-link" href="admin/names">Names</NavLink>
            <NavLink class="top-bar-link" href="admin/stats">Admin</NavLink>
        </nav>
        <div class="top-bar-actions">
            <div class="theme-picker" @onclick="ToggleThemeDropdown" @onclick:stopPropagation="true" title="Change theme">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" style="cursor:pointer; opacity:0.6;">
                    <path d="M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1zm0 1.2a5.8 5.8 0 0 1 4.1 9.9 3.5 3.5 0 0 0-2.1-.7 3.5 3.5 0 0 1-3.5-3.5c0-1.5.9-2.7 2.2-3.2A5.8 5.8 0 0 1 8 2.2zM4.5 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2zm1-2a1 1 0 1 1 0 2 1 1 0 0 1 0-2zm3-1a1 1 0 1 1 0 2 1 1 0 0 1 0-2zm2 2a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
                </svg>
            </div>
            @if (_showThemeDropdown)
            {
                <div class="theme-dropdown" @onclick:stopPropagation="true">
                    @foreach (var theme in ThemeService.Themes)
                    {
                        @if (theme.Key == "default-dark")
                        {
                            <hr style="margin: 4px 0; opacity: 0.3;" />
                        }
                        <div class="theme-option @(theme.Key == ThemeService.CurrentThemeKey ? "active" : "")"
                             @onclick="() => SelectTheme(theme.Key)">
                            @theme.Name
                        </div>
                    }
                </div>
            }
        </div>
    </header>

    <main>
        <article class="content px-2">
            <TelerikRootComponent EnableRtl="@IsRtlEnabled">
                <TelerikNotification @ref="_notificationRef"
                                     HorizontalPosition="@NotificationHorizontalPosition.Right"
                                     VerticalPosition="@NotificationVerticalPosition.Top"
                                     AnimationType="@AnimationType.Fade" />
                @Body
            </TelerikRootComponent>
        </article>
    </main>
</div>

@code {
    [Inject]
    private NavigationManager NavigationManager { get; set; }

    private bool IsRtlEnabled { get; set; }
    private TelerikNotification? _notificationRef;
    private bool _showThemeDropdown;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ThemeService.InitAsync();
            StateHasChanged();
        }
    }

    protected override void OnInitialized()
    {
        NotificationService.OnNotification += HandleNotification;
    }

    private void ToggleThemeDropdown()
    {
        _showThemeDropdown = !_showThemeDropdown;
    }

    private async Task SelectTheme(string key)
    {
        await ThemeService.SetThemeAsync(key);
        _showThemeDropdown = false;
    }

    private void HandleNotification(NotificationMessage msg)
    {
        var themeColor = msg.Level switch
        {
            NotificationLevel.Error => ThemeConstants.Notification.ThemeColor.Error,
            NotificationLevel.Warning => ThemeConstants.Notification.ThemeColor.Warning,
            NotificationLevel.Success => ThemeConstants.Notification.ThemeColor.Success,
            _ => ThemeConstants.Notification.ThemeColor.Info
        };

        _notificationRef?.Show(new NotificationModel
        {
            Text = msg.Text,
            ThemeColor = themeColor,
            CloseAfter = 5000,
            Closable = true
        });
    }

    public override async Task SetParametersAsync(ParameterView parameters)
    {
        SetRtlForLocation();

        await base.SetParametersAsync(parameters);
    }

    private void SetRtlForLocation()
    {
        IsRtlEnabled = NavigationManager.Uri.Contains("rtl");
    }

    public void Dispose()
    {
        NotificationService.OnNotification -= HandleNotification;
    }
}

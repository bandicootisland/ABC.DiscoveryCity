@using Telerik.Blazor
@using Telerik.Blazor.Components
@using Telerik.Blazor.Components.Common.Icon

<div class="row mb-3">
    <div class="col-md-4">
        <EditForm Model="@this" OnValidSubmit="@OnSearchClicked">
            <div class="input-group">
                <TelerikTextBox @bind-Value="@_localSearchText"
                                OnChange="@OnSearchTextChanged"
                                PlaceHolder="Enter search term..." Width="100%" />
                @if (!string.IsNullOrEmpty(_localSearchText))
                {
                    <TelerikButton OnClick="@OnClearSearch" Icon="@SvgIcon.X" Title="Clear search"
                                   ButtonType="@ButtonType.Button" />
                }
                <TelerikButton ButtonType="@ButtonType.Submit" Icon="@SvgIcon.Search">Search</TelerikButton>
                <TelerikButton OnClick="@OnAdvancedFindClicked" Icon="@SvgIcon.Filter" Title="Advanced Find"
                               ButtonType="@ButtonType.Button" />
                @if (TotalCount > 0)
                {
                    <span class="ms-2 text-muted small" style="white-space: nowrap;"><strong>@TotalCount.ToString("N0")</strong> found</span>
                }
            </div>
        </EditForm>
    </div>
    <div class="col-md-5">
        <TelerikMultiSelect Data="@AvailableDataSets"
                            @bind-Value="@SelectedDataSets"
                            Placeholder="All DataSets (click to select)"
                            Width="100%"
                            AutoClose="false"
                            Filterable="true"
                            OnChange="@OnDataSetSelectionChanged" />
    </div>
    <div class="col-md-3">
        <div class="d-flex align-items-center gap-1">
            <TelerikMultiSelect Data="@AvailableNames"
                                @bind-Value="@SelectedNames"
                                Placeholder="Name filter..."
                                Width="100%"
                                AutoClose="false"
                                Filterable="true"
                                AllowCustom="true"
                                OnChange="@OnNamesSelectionChanged" />
            <TelerikButton OnClick="@OnNamesSearchClicked" Icon="@SvgIcon.Search" Title="Search with selected name filter"
                           Enabled="@(SelectedNames.Count > 0)" ThemeColor="@ThemeConstants.Button.ThemeColor.Primary" />
            @if (HasActiveFilters)
            {
                <TelerikButton OnClick="@OnClearAll" Icon="@SvgIcon.FilterClear" Title="Clear all filters" />
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public string SearchQuery { get; set; } = "";
    [Parameter] public EventCallback<string> SearchQueryChanged { get; set; }
    [Parameter] public List<string> AvailableDataSets { get; set; } = new();
    [Parameter] public List<string> SelectedDataSets { get; set; } = new();
    [Parameter] public EventCallback<List<string>> SelectedDataSetsChanged { get; set; }
    [Parameter] public List<string> AvailableNames { get; set; } = new();
    [Parameter] public List<string> SelectedNames { get; set; } = new();
    [Parameter] public EventCallback<List<string>> SelectedNamesChanged { get; set; }
    [Parameter] public EventCallback OnSearch { get; set; }
    [Parameter] public EventCallback OnDataSetChanged { get; set; }
    [Parameter] public EventCallback OnNamesSearch { get; set; }
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public EventCallback OnAdvancedFind { get; set; }

    // Local backing field — isolates the text box from parent re-renders
    private string _localSearchText = "";

    protected override void OnInitialized()
    {
        _localSearchText = SearchQuery;
    }

    private bool HasActiveFilters =>
        !string.IsNullOrEmpty(_localSearchText) || SelectedDataSets.Count > 0 || SelectedNames.Count > 0;

    private async Task OnSearchTextChanged(object newValue)
    {
        _localSearchText = newValue?.ToString() ?? "";
        await SearchQueryChanged.InvokeAsync(_localSearchText);
        await OnSearch.InvokeAsync();
    }

    private async Task OnSearchClicked()
    {
        // Sync local text to parent before searching
        await SearchQueryChanged.InvokeAsync(_localSearchText);
        await OnSearch.InvokeAsync();
    }

    private async Task OnAdvancedFindClicked()
    {
        await OnAdvancedFind.InvokeAsync();
    }

    private async Task OnClearSearch()
    {
        _localSearchText = "";
        await SearchQueryChanged.InvokeAsync("");
        await OnSearch.InvokeAsync();
    }

    private async Task OnClearAll()
    {
        _localSearchText = "";
        SelectedDataSets = new();
        SelectedNames = new();
        _previousNamesCount = 0;
        await SearchQueryChanged.InvokeAsync("");
        await SelectedDataSetsChanged.InvokeAsync(SelectedDataSets);
        await SelectedNamesChanged.InvokeAsync(SelectedNames);
        await OnSearch.InvokeAsync();
    }

    private async Task OnDataSetSelectionChanged()
    {
        await SelectedDataSetsChanged.InvokeAsync(SelectedDataSets);
        await OnDataSetChanged.InvokeAsync();
    }

    private int _previousNamesCount;

    private async Task OnNamesSelectionChanged()
    {
        await SelectedNamesChanged.InvokeAsync(SelectedNames);

        // Auto-search when names are cleared (user removed all selections)
        if (SelectedNames.Count == 0 && _previousNamesCount > 0)
        {
            _previousNamesCount = 0;
            await OnNamesSearch.InvokeAsync();
        }
        else
        {
            _previousNamesCount = SelectedNames.Count;
        }
    }

    private async Task OnNamesSearchClicked()
    {
        if (SelectedNames.Count == 0) return;
        _previousNamesCount = SelectedNames.Count;
        await OnNamesSearch.InvokeAsync();
    }
}

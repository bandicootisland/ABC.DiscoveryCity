@using ABC.DiscoveryCity.Services
@using Telerik.Blazor
@using Telerik.Blazor.Components
@inject SearchService SearchService
@inject NotificationService NotificationService

@* External link bar — always visible when a download URL is available *@
@if (!string.IsNullOrEmpty(DownloadUrl))
{
    <div class="d-flex align-items-center gap-2 px-3 py-1 small"
         style="background: var(--kendo-base-bg, #f8f9fa); border-bottom: 1px solid var(--kendo-component-border, #dee2e6);">
        <TelerikIcon Icon="@SvgIcon.HyperlinkOpen" />
        <a href="@DownloadUrl" target="_blank" rel="noopener noreferrer" class="text-break" @onclick="OnDownloadClicked">
            @DownloadUrl
        </a>
    </div>
}

@if (IsLoading || _isUploading)
{
    <div class="d-flex align-items-center justify-content-center" style="height: 100%;">
        <TelerikLoader Visible="true" />
        <span class="ms-2">@(_isUploading ? "Uploading..." : "Loading PDF...")</span>
    </div>
}
else if (_data != null && _data.Length > 0)
{
    @if (_uploadSource != null)
    {
        <div class="d-flex align-items-center gap-2 px-3 py-1 small"
             style="background: var(--kendo-info-bg, #cfe2ff); border-bottom: 1px solid var(--kendo-component-border, #dee2e6); color: var(--kendo-info-text, #084298);">
            <TelerikIcon Icon="@SvgIcon.Upload" />
            <span>User-supplied file: @_uploadSource</span>
        </div>
    }
    <TelerikPdfViewer Data="@_data"
                      Zoom="@Zoom"
                      Width="100%"
                      Height="@Height" />
}
else
{
    @* Fallback: show preview image if available, otherwise a message *@
    <div class="d-flex flex-column align-items-center justify-content-center" style="height: 100%; padding: 20px;">
        @if (!string.IsNullOrEmpty(PreviewImageUrl))
        {
            <img src="@PreviewImageUrl"
                 style="max-width: 100%; max-height: 50vh; object-fit: contain; border: 1px solid var(--kendo-component-border, #ddd); box-shadow: 2px 2px 8px rgba(0,0,0,0.15);"
                 alt="Document preview" />
            <div class="text-muted small mt-2">Preview image — full PDF not available locally</div>
        }
        else
        {
            <div class="text-muted">
                <TelerikIcon Icon="@SvgIcon.FilePdf" />
                <span class="ms-1">@(_error ?? "PDF not available locally.")</span>
            </div>
        }

        @if (!string.IsNullOrEmpty(DownloadUrl))
        {
            <a href="@DownloadUrl" target="_blank" rel="noopener noreferrer"
               class="btn btn-outline-primary mt-3" @onclick="OnDownloadClicked">
                <TelerikIcon Icon="@SvgIcon.Download" /> Download from source
            </a>
        }

        @* Upload button — always show when PDF is missing and we have a document path *@
        @if (!string.IsNullOrEmpty(FilePath))
        {
            <div class="mt-3 text-center">
                <div class="text-muted small mb-2">
                    @if (_showUploadHint)
                    {
                        <span>Downloaded? Select the file to upload it:</span>
                    }
                    else
                    {
                        <span>Have the file already? Upload it here:</span>
                    }
                </div>
                <InputFile OnChange="@OnFileSelected" accept=".pdf" class="d-none" id="@_inputId" />
                <label for="@_inputId" class="btn btn-primary" style="cursor: pointer;">
                    <TelerikIcon Icon="@SvgIcon.Upload" /> Select PDF to Upload
                </label>
            </div>
        }

        @* Show previously uploaded user files *@
        @if (_userEdits.Count > 0)
        {
            <div class="mt-3">
                <div class="text-muted small mb-1">Previously uploaded:</div>
                @foreach (var edit in _userEdits)
                {
                    <button class="btn btn-sm btn-outline-secondary me-1 mb-1" @onclick="@(() => LoadUserEdit(edit))">
                        <TelerikIcon Icon="@SvgIcon.FilePdf" /> @edit.FileName
                    </button>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter] public string? FilePath { get; set; }
    [Parameter] public byte[]? Data { get; set; }
    [Parameter] public decimal Zoom { get; set; } = 1.0m;
    [Parameter] public string Height { get; set; } = "100%";
    [Parameter] public string? DownloadUrl { get; set; }
    [Parameter] public string? PreviewImageUrl { get; set; }
    [Parameter] public bool AutoLoad { get; set; } = true;

    private byte[]? _data;
    private string? _loadedPath;
    private string? _error;
    private bool _isUploading;
    private bool _showUploadHint;
    private string? _uploadSource;
    private List<UserEditResult> _userEdits = new();
    private string _inputId = $"pdf-upload-{Guid.NewGuid():N}";

    public bool IsLoading { get; private set; }
    public bool IsLoaded => _data is { Length: > 0 };

    protected override async Task OnParametersSetAsync()
    {
        if (Data != null)
        {
            _data = Data;
            _loadedPath = FilePath;
            return;
        }

        if (FilePath != _loadedPath)
        {
            _data = null;
            _loadedPath = null;
            _error = null;
            _uploadSource = null;
            _showUploadHint = false;
            _userEdits = new();

            if (AutoLoad && !string.IsNullOrEmpty(FilePath))
            {
                await LoadAsync();
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Load user edits list when we don't have the main PDF
        if (firstRender && !IsLoaded && !string.IsNullOrEmpty(FilePath))
        {
            _userEdits = await SearchService.GetUserEditsAsync(FilePath);
            if (_userEdits.Count > 0)
                StateHasChanged();
        }
    }

    public async Task LoadAsync()
    {
        if (string.IsNullOrEmpty(FilePath) || IsLoading) return;
        if (FilePath == _loadedPath && _data != null) return;

        IsLoading = true;
        _error = null;
        StateHasChanged();

        try
        {
            _data = await SearchService.GetPdfBytesAsync(FilePath);
            _loadedPath = FilePath;

            if (_data == null || _data.Length == 0)
            {
                _error = "File not available locally.";
                _userEdits = await SearchService.GetUserEditsAsync(FilePath);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"PdfDocumentViewer load error: {ex.Message}");
            _error = "Failed to load PDF.";
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private void OnDownloadClicked()
    {
        _showUploadHint = true;
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        if (string.IsNullOrEmpty(FilePath)) return;

        var file = e.File;
        if (file == null || file.Size == 0) return;

        // Read file into memory BEFORE re-rendering — the InputFile JS interop reference
        // is destroyed when StateHasChanged() swaps in the loading spinner.
        byte[] fileBytes;
        var fileName = file.Name;
        using (var stream = file.OpenReadStream(maxAllowedSize: 100 * 1024 * 1024))
        {
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            fileBytes = ms.ToArray();
        }

        _isUploading = true;
        StateHasChanged();

        try
        {
            using var uploadStream = new MemoryStream(fileBytes);
            var result = await SearchService.UploadUserFileAsync(FilePath, uploadStream, fileName);

            if (result != null)
            {
                // Load the uploaded file into the viewer
                var bytes = await SearchService.GetUserEditBytesAsync(result.Id);
                if (bytes is { Length: > 0 })
                {
                    _data = bytes;
                    _uploadSource = fileName;
                    _error = null;
                    NotificationService.ShowSuccess($"Uploaded {fileName} successfully");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"File upload error: {ex.Message}");
            NotificationService.ShowError($"Upload failed: {ex.Message}");
        }
        finally
        {
            _isUploading = false;
            StateHasChanged();
        }
    }

    private async Task LoadUserEdit(UserEditResult edit)
    {
        IsLoading = true;
        StateHasChanged();

        try
        {
            var bytes = await SearchService.GetUserEditBytesAsync(edit.Id);
            if (bytes is { Length: > 0 })
            {
                _data = bytes;
                _uploadSource = edit.FileName;
                _error = null;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Load user edit error: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }
}

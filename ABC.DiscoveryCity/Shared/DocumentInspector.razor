@using ABC.DiscoveryCity.Models
@using ABC.DiscoveryCity.Services
@inject SearchService SearchService

<div class="inspector-pane @(Document != null ? "open" : "")">
    @if (Document != null)
    {
        <div class="inspector-header">
            <div>
                <h2>@Document.Title</h2>
            </div>
            <div>
                <button class="btn-icon">📥</button> <button class="btn-close" @onclick="OnCloseClicked">×</button>
            </div>
        </div>

        <div class="inspector-tabs">
            <button class="@(ActiveTab == "Overview" ? "active" : "")" @onclick="@(() => SetTab("Overview"))">Overview</button>
            <button class="@(ActiveTab == "PDF" ? "active" : "")" @onclick="@(() => SetTab("PDF"))">PDF Viewer</button>
            <button class="@(ActiveTab == "Metadata" ? "active" : "")" @onclick="@(() => SetTab("Metadata"))">Metadata</button>
        </div>

        <div class="inspector-body">
            @if (ActiveTab == "Overview")
            {
                <div class="split-overview">
                    <div class="overview-page-image">
                        <div class="placeholder-image">Document Scan Placeholder</div>
                    </div>
                    <div class="overview-text">
                        <h3>Text Preview</h3>
                        <div class="document-text-container">
                            @Document.Snippet
                        </div>
                    </div>
                </div>
            }
            else if (ActiveTab == "PDF")
            {
                @if (IsPdf)
                {
                    <PdfDocumentViewer FilePath="@Document.FilePath"
                                       DownloadUrl="@ReconstructedDownloadUrl"
                                       PreviewImageUrl="@PreviewImageUrl"
                                       AutoLoad="true"
                                       Height="calc(100vh - 200px)" />
                }
                else
                {
                    <div class="d-flex align-items-center justify-content-center text-muted" style="height: 300px;">
                        <span>PDF viewer is only available for PDF documents.</span>
                    </div>
                }
            }
            else if (ActiveTab == "Metadata")
            {
                <div class="meta-grid">
                    <div>Date: <span class="meta-value">@Document.CreatedDate.ToShortDateString()</span></div>
                    <div>Author: <span class="meta-value">@Document.Author</span></div>
                    <div>Pages: <span class="meta-value">@Document.PageCount</span></div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public DocumentNode? Document { get; set; }
    [Parameter] public EventCallback OnCloseClicked { get; set; }

    private string ActiveTab = "Overview";

    private bool IsPdf => Document?.Title?.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase) == true;

    private string? PreviewImageUrl =>
        string.IsNullOrEmpty(Document?.ThumbnailPath)
            ? null
            : $"{SearchService.ApiBaseUrl}/api/images/view?path={Uri.EscapeDataString(Document.ThumbnailPath)}";

    private string? ReconstructedDownloadUrl
    {
        get
        {
            if (string.IsNullOrEmpty(Document?.SourceUrl) || string.IsNullOrEmpty(Document?.Title))
                return null;
            var baseUrl = Document.SourceUrl.TrimEnd('/');
            if (!string.IsNullOrEmpty(Document.DataSetName))
                return $"{baseUrl}/{Uri.EscapeDataString(Document.DataSetName)}/{Uri.EscapeDataString(Document.Title)}";
            return $"{baseUrl}/{Uri.EscapeDataString(Document.Title)}";
        }
    }

    private void SetTab(string tab)
    {
        ActiveTab = tab;
    }

    protected override void OnParametersSet()
    {
        if (Document == null)
            ActiveTab = "Overview";
    }
}

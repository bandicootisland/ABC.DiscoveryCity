    private async Task ScanNamesAsync()
    {
        if (Document == null)
            return;

        var documentId = Document.Id;
        IsScanningNames = true;
        try
        {
            var result = await SearchService.ScanDocumentNamesAsync(documentId, Document.FilePath);
            if (result == null)
                return;

            LastNameScanResult = result;
            await LoadSavedNameScanAsync(force: true);

            if (result.CandidateNameCount == 0)
            {
                NotificationService.ShowInfo("No name-like candidates found.");
                return;
            }

            var sample = result.Candidates.Count > 0
                ? ": " + string.Join(", ", result.Candidates.Take(5).Select(c => c.DisplayName))
                : "";
            NotificationService.ShowSuccess(
                $"Saved {result.CandidateNameCount} candidates, {result.MentionsInserted} mentions and {result.RelationshipEvidenceInserted} links for review{sample}");
        }
        finally
        {
            IsScanningNames = false;
        }
    }

    private static string StripDrivePrefix(string path)
    {
        var segments = path.Replace('\\', '/').Split('/', StringSplitOptions.RemoveEmptyEntries);

        for (int i = 0; i < segments.Length; i++)
        {
            if (segments[i].Equals("EpsteinFiles", StringComparison.OrdinalIgnoreCase)
                || segments[i].Equals("Downloads", StringComparison.OrdinalIgnoreCase)
                || segments[i].Equals("Developer.DiscoveryCity", StringComparison.OrdinalIgnoreCase))
            {
                if (i + 1 < segments.Length)
                    return "[drive]/" + string.Join("/", segments[(i + 1)..]);
                return "[drive]/" + segments[i];
            }
        }

        if (path.StartsWith("/media/", StringComparison.OrdinalIgnoreCase) && segments.Length > 3)
            return "[drive]/" + string.Join("/", segments[3..]);
        if (path.Length >= 3 && path[1] == ':' && (path[2] == '\\' || path[2] == '/'))
            return "[drive]/" + string.Join("/", segments[1..]);

        return path;
    }

    private static string FormatDate(DateTime? date)
    {
        return date.HasValue && date.Value.Year > 1
            ? date.Value.ToString("yyyy-MM-dd")
            : "";
    }

    private async Task LoadSavedNameScanAsync(bool force = false)
    {
        if (!CanLoadNameScan || Document == null)
            return;

        var documentKey = GetDocumentKey(Document);
        if (!force && documentKey == _loadedNameScanKey)
            return;

        IsLoadingNameScan = true;
        StateHasChanged();
        try
        {
            NameResearchView = await SearchService.GetNameResearchAsync(Document.Id, Document.FilePath);
            _loadedNameScanKey = documentKey;
        }
        finally
        {
            IsLoadingNameScan = false;
        }
    }

    private static List<SentenceViewRow> BuildSentenceRows(string? text)
    {
        var rows = new List<SentenceViewRow>();
        if (string.IsNullOrWhiteSpace(text))
            return rows;

        var matches = System.Text.RegularExpressions.Regex.Matches(
            text,
            @"\[(\d+)\]\s*(.*?)(?=\s*\[\d+\]\s|\z)",
            System.Text.RegularExpressions.RegexOptions.Singleline);

        foreach (System.Text.RegularExpressions.Match match in matches)
        {
            if (!int.TryParse(match.Groups[1].Value, out var ordinal))
                ordinal = rows.Count + 1;

            var sentenceText = System.Text.RegularExpressions.Regex
                .Replace(match.Groups[2].Value, @"\s+", " ")
                .Trim();

            if (sentenceText.Length > 0)
                rows.Add(new SentenceViewRow { Ordinal = ordinal, Text = sentenceText });
        }

        if (rows.Count > 0)
            return rows;

        return text.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select((line, index) => new SentenceViewRow { Ordinal = index + 1, Text = line })
            .Where(row => !string.IsNullOrWhiteSpace(row.Text))
            .ToList();
    }


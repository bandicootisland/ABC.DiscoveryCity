@using ABC.DiscoveryCity.Services
@using System.Text.Json
@using static ABC.DiscoveryCity.Services.TextFormatExtensions
@using Telerik.Blazor
@using Telerik.Blazor.Components
@using Telerik.Blazor.Components.Common.Icon
@inject SearchService SearchService
@inject IJSRuntime JS
@inject NotificationService NotificationService

<TelerikTabStrip ActiveTabIndex="@ActiveTabIndex" ActiveTabIndexChanged="@OnTabChanged">
    <TabStripTab Title="Overview">
        <div class="p-3">
             <div class="row">
                <div class="col-md-5">
                    @if (!string.IsNullOrEmpty(Document?.ThumbnailPath))
                    {
                        <img src="@($"{SearchService.ApiBaseUrl}/api/images/view?path={Uri.EscapeDataString(Document.FullImagePath ?? Document.ThumbnailPath)}")"
                             style="width: 100%; height: auto; border: 1px solid var(--kendo-component-border, #ddd); box-shadow: 2px 2px 5px rgba(0,0,0,0.1); max-height: 600px; object-fit: contain;" />
                    }
                    else if (Document?.Id != Guid.Empty)
                    {
                        <img src="@SearchService.GetThumbnailUrl(Document.Id, "full")"
                             style="width: 100%; height: auto; border: 1px solid var(--kendo-component-border, #ddd); box-shadow: 2px 2px 5px rgba(0,0,0,0.1); max-height: 600px; object-fit: contain;"
                             loading="lazy" />
                    }
                    else
                    {
                        <div class="text-center p-5 bg-light text-muted border" style="height: 300px; display: flex; align-items: center; justify-content: center; flex-direction: column;">
                            <TelerikIcon Icon="@FileIcon" Size="large" />
                            <div class="mt-2">@FileCategoryLabel</div>
                        </div>
                    }

                    <div class="mt-4 p-3 bg-light border rounded">
                         <h6 class="border-bottom pb-2">Document Metadata</h6>
                         <ul class="list-unstyled mb-0">
                             <li class="mb-1"><strong>Est. Date:</strong> @FormatDate(Document?.Date)</li>
                             <li class="mb-1"><strong>@PageCountLabel:</strong> @Document?.PageCount</li>
                             <li class="mb-1"><strong>Relevance:</strong> @($"{Math.Max(0, (1 - (Document?.Distance ?? 1)) * 100):F0}%")</li>
                             <li class="mb-1"><strong>File:</strong> <span class="text-break">@Document?.FileName</span></li>
                         </ul>
                    </div>
                </div>
                <div class="col-md-7">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h4 class="mb-0">@TextPreviewTitle</h4>
                        @if (!string.IsNullOrEmpty(Document?.Text))
                        {
                            <TelerikButton OnClick="@CopyTextToClipboard" Icon="@SvgIcon.Copy" Title="Copy text to clipboard" />
                        }
                    </div>
                    <div class="card h-100">
                        <div class="card-body" style="max-height: 600px; overflow-y: auto; background-color: var(--kendo-base-bg, #f9f9f9); font-family: 'Consolas', 'Monaco', monospace; font-size: 0.95em; line-height: 1.5;">
                            <div style="color: var(--kendo-subtle-text, #666); margin-bottom: 1em;">[@ContentTypeLabel]<br/><br/></div>
                            @if (!string.IsNullOrEmpty(Document?.Text))
                            {
                                @((MarkupString)Document.Text.FormatWithSentenceBreaks().HighlightSearchTerms(SearchQuery))
                            }
                            else
                            {
                                <span class="text-muted fst-italic">No text content available.</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </TabStripTab>
    <TabStripTab Title="@ViewerTabTitle">
        @if (Category == FileCategory.Pdf)
        {
            <PdfDocumentViewer Data="@ViewerData"
                               FilePath="@Document?.FilePath"
                               DownloadUrl="@ReconstructedDownloadUrl"
                               PreviewImageUrl="@PreviewImageUrl"
                               AutoLoad="false"
                               Height="800px" />
        }
        else if (HasNativeViewer)
        {
            @if (IsLoadingViewer)
            {
                <div class="d-flex align-items-center justify-content-center" style="height: 800px;">
                    <TelerikLoader Visible="true" />
                    <span class="ms-2">Loading @FileCategoryLabel...</span>
                </div>
            }
            else if (ViewerData != null && ViewerData.Length > 0)
            {
                <TelerikSpreadsheet Data="@ViewerData"
                                    Height="800px"
                                    Width="100%" />
            }
            else
            {
                <div class="d-flex flex-column align-items-center justify-content-center text-muted" style="height: 800px;">
                    <div>
                        <TelerikIcon Icon="@FileIcon" />
                        <span class="ms-2">File not available locally.</span>
                    </div>
                    @if (ReconstructedDownloadUrl != null)
                    {
                        <a href="@ReconstructedDownloadUrl" target="_blank" rel="noopener noreferrer" class="mt-2">
                            <TelerikIcon Icon="@SvgIcon.Download" /> Download from source
                        </a>
                    }
                </div>
            }
        }

        else if (Category == FileCategory.Video && !string.IsNullOrEmpty(FileViewUrl))
        {
            <div style="height: 800px; display: flex; flex-direction: column; background: #000;">
                <video controls style="width: 100%; max-height: 700px; flex: 1;" preload="metadata">
                    <source src="@FileViewUrl" type="video/mp4" />
                    Your browser does not support the video element.
                </video>
                <div style="padding: 8px 12px; background: var(--kendo-base-bg, #1a1a1a); color: var(--kendo-subtle-text, #aaa); font-size: 0.85em; display: flex; align-items: center; gap: 8px;">
                    @Document?.FileName
                    @{
                        var vq = GetMetadataValue("VideoQuality");
                        if (vq == "original")
                        {
                            <span class="badge" style="background: #28a745; color: #fff; font-size: 0.75em;">Original</span>
                        }
                        else if (vq == "proxy_720p")
                        {
                            <span class="badge" style="background: #ffc107; color: #333; font-size: 0.75em;">720p Reduced</span>
                        }
                        else if (string.IsNullOrEmpty(vq))
                        {
                            <span class="badge" style="background: #6c757d; color: #fff; font-size: 0.75em;">Disk Only</span>
                        }
                    }
                    @if (!string.IsNullOrEmpty(Document?.Text))
                    {
                        <span class="ms-2">@Document.Text.Replace("\n", " ").Trim()</span>
                    }
                </div>
            </div>
        }
        else if (Category == FileCategory.Audio && !string.IsNullOrEmpty(FileViewUrl))
        {
            <div style="height: 800px; padding: 20px; background-color: var(--kendo-base-bg, #f9f9f9);">
                <div class="mb-3 d-flex align-items-center gap-2">
                    <TelerikIcon Icon="@FileIcon" />
                    <strong>@Document?.FileName</strong>
                </div>
                <audio controls style="width: 100%;" preload="metadata">
                    <source src="@FileViewUrl" type="@FileContentType" />
                    Your browser does not support the audio element.
                </audio>
                @if (!string.IsNullOrEmpty(Document?.Text))
                {
                    <div style="margin-top: 16px; font-family: 'Consolas', monospace; font-size: 0.9em; color: var(--kendo-subtle-text, #666);">
                        @((MarkupString)Document.Text.FormatWithSentenceBreaks())
                    </div>
                }
            </div>
        }
        else if (Category == FileCategory.Image)
        {
            @* Use preview image if available (smaller), fall back to full original, then FilePath *@
            var imgUrl = ImageViewerUrl;

            if (!string.IsNullOrEmpty(imgUrl))
            {
                <div style="height: 800px; display: flex; flex-direction: column; align-items: center; justify-content: center; background: var(--kendo-base-bg, #1a1a1a); overflow: auto;">
                    <img src="@imgUrl" style="max-width: 100%; max-height: 750px; object-fit: contain;" alt="@Document?.FileName" />
                    <div style="padding: 8px; color: var(--kendo-subtle-text, #aaa); font-size: 0.85em;">
                        @Document?.FileName
                        @if (!string.IsNullOrEmpty(Document?.Text))
                        {
                            <span class="ms-3">@Document.Text.Replace("\n", " ").Trim()</span>
                        }
                    </div>
                </div>
            }
            else
            {
                <div style="height: 800px; display: flex; align-items: center; justify-content: center; color: var(--kendo-subtle-text, #aaa);">
                    No image path available for @Document?.FileName
                </div>
            }
        }
        else
        {
            <div style="height: 800px; overflow-y: auto; padding: 20px; background-color: var(--kendo-base-bg, #f9f9f9); font-family: 'Consolas', 'Monaco', monospace; font-size: 0.9em; line-height: 1.5;">
                <div class="mb-3 d-flex align-items-center gap-2">
                    <TelerikIcon Icon="@FileIcon" />
                    <strong>@FileCategoryLabel</strong>
                    <span class="text-muted">— @Document?.FileName</span>
                </div>
                <div style="color: var(--kendo-subtle-text, #666); margin-bottom: 1em;">[@ContentTypeLabel]<br/><br/></div>
                @if (!string.IsNullOrEmpty(Document?.Text))
                {
                    @((MarkupString)Document.Text.FormatWithSentenceBreaks().HighlightSearchTerms(SearchQuery))
                }
                else
                {
                    <span class="text-muted fst-italic">No content available.</span>
                    @if (ReconstructedDownloadUrl != null)
                    {
                        <div class="mt-2">
                            <a href="@ReconstructedDownloadUrl" target="_blank" rel="noopener noreferrer">
                                <TelerikIcon Icon="@SvgIcon.Download" /> Download from source
                            </a>
                        </div>
                    }
                }
            </div>
        }
    </TabStripTab>
    <TabStripTab Title="Images" Visible="@ShowImagesTab">
        <div class="p-3">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <TelerikButton OnClick="@PrevImagePage" Icon="@SvgIcon.ChevronLeft"
                                   Enabled="@(_imagePageIndex > 0)" Title="Previous image" />
                    <span style="font-weight: 600;">Image @(_imagePageIndex + 1) of @_imagePages.Count</span>
                    <TelerikButton OnClick="@NextImagePage" Icon="@SvgIcon.ChevronRight"
                                   Enabled="@(_imagePageIndex < _imagePages.Count - 1)" Title="Next image" />
                </div>
                <span style="color: var(--kendo-subtle-text, #888); font-size: 0.9em;">
                    Page @(_imagePages.Count > 0 ? _imagePages[_imagePageIndex].Page : 0) &bull; @(_imagePages.Count > 0 ? _imagePages[_imagePageIndex].Info : "")
                </span>
            </div>
            @if (_imagePages.Count > 0 && Document?.Id != Guid.Empty)
            {
                <img src="@SearchService.GetPageImageUrl(Document!.Id, _imagePages[_imagePageIndex].Page)"
                     style="width: 100%; height: auto; border: 1px solid var(--kendo-component-border, #ddd); box-shadow: 2px 2px 5px rgba(0,0,0,0.1); max-height: 700px; object-fit: contain;" />
            }
        </div>
    </TabStripTab>
    <TabStripTab Title="Metadata">
        <div class="p-3">
            @if (!string.IsNullOrEmpty(RemoteUrl))
            {
                <div class="mb-3 p-3 bg-light border rounded">
                    <h6 class="border-bottom pb-2">Remote Source</h6>
                    <a href="@RemoteUrl" target="_blank" rel="noopener noreferrer" class="text-break">
                        <TelerikIcon Icon="@SvgIcon.HyperlinkOpen" /> @RemoteUrl
                    </a>
                </div>
            }
            <div class="card">
                <div class="card-header"><strong>Document Metadata (JSONB)</strong></div>
                <div class="card-body" style="max-height: 600px; overflow-y: auto;">
                    @if (MetadataEntries.Count > 0)
                    {
                        <table class="table table-sm table-striped mb-0">
                            <thead>
                                <tr><th style="width: 200px;">Property</th><th>Value</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var entry in MetadataEntries)
                                {
                                    <tr>
                                        <td><strong>@entry.Key</strong></td>
                                        <td class="text-break" style="font-family: 'Consolas', monospace; font-size: 0.9em;">@((MarkupString)System.Net.WebUtility.HtmlEncode(entry.Value).HighlightSearchTerms(SearchQuery))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <span class="text-muted fst-italic">No metadata available.</span>
                    }
                </div>
            </div>
        </div>
    </TabStripTab>
    <TabStripTab Title="Name Research">
        <div class="p-3">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div>
                    <h5 class="mb-0">Name Research</h5>
                    <div class="text-muted small">Document-level name extraction, review, and sentence evidence.</div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <TelerikButton OnClick="@ScanNamesAsync" Icon="@SvgIcon.Search"
                                   Title="Scan this document for people names"
                                   Enabled="@CanScanNames">@ScanNamesButtonText</TelerikButton>
                    <TelerikButton OnClick="@RefreshNameScanAsync" Icon="@SvgIcon.ArrowRotateCw"
                                   Title="Reload saved research names"
                                   FillMode="@ThemeConstants.Button.FillMode.Flat"
                                   Enabled="@CanLoadNameScan">Refresh</TelerikButton>
                    @if (!string.IsNullOrEmpty(Document?.Text))
                    {
                        <TelerikButton OnClick="@CopyTextToClipboard" Icon="@SvgIcon.Copy" Title="Copy sentence text" FillMode="@ThemeConstants.Button.FillMode.Flat" />
                    }
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <strong>Name scan review</strong>
                    @if (NameResearchView != null)
                    {
                        <span class="small text-muted">
                            @NameResearchView.PersonCount people,
                            @NameResearchView.AliasCount name links,
                            @NameResearchView.MentionCount mentions
                        </span>
                    }
                </div>
                <div class="card-body p-2">
                    @if (IsLoadingNameScan)
                    {
                        <div class="d-flex align-items-center gap-2 p-3 text-muted">
                            <TelerikLoader Visible="true" />
                            <span>Loading saved name scan...</span>
                        </div>
                    }
                    else if (NameResearchView == null)
                    {
                        <div class="p-3 text-muted">
                            No saved name scan loaded for this document. Click <strong>Scan names</strong> to extract and save candidates.
                        </div>
                    }
                    else if (NameResearchPeople.Count == 0)
                    {
                        <div class="p-3 text-muted">No name-like candidates saved for this document.</div>
                    }
                    else
                    {
                        <TelerikGrid Data="@NameResearchPeople"
                                     Pageable="true"
                                     PageSize="10"
                                     Sortable="true"
                                     Resizable="true"
                                     Height="320px"
                                     OnRowClick="@OnNamePersonRowClick">
                            <GridColumns>
                                <GridColumn Field="@nameof(ResearchPersonGroupDto.DisplayName)" Title="Name" />
                                <GridColumn Field="@nameof(ResearchPersonGroupDto.Status)" Title="Status" Width="120px" />
                                <GridColumn Field="@nameof(ResearchPersonGroupDto.Confidence)" Title="Confidence" DisplayFormat="{0:P0}" Width="130px" />
                                <GridColumn Field="@nameof(ResearchPersonGroupDto.AliasCount)" Title="Name Links" Width="110px" />
                                <GridColumn Field="@nameof(ResearchPersonGroupDto.LinkedNameCount)" Title="Linked Names" Width="130px" />
                                <GridColumn Field="@nameof(ResearchPersonGroupDto.MentionCount)" Title="Mentions" Width="110px" />
                                <GridColumn Title="Name Links" Width="260px">
                                    <Template>
                                        @{
                                            var person = (ResearchPersonGroupDto)context;
                                        }
                                        <span class="small text-muted">@string.Join(", ", person.Aliases.Take(4).Select(a => a.Alias))</span>
                                    </Template>
                                </GridColumn>
                            </GridColumns>
                            <DetailTemplate>
                                @{
                                    var person = (ResearchPersonGroupDto)context;
                                }
                                <div class="p-3 bg-light border-top" @onclick:stopPropagation="true">
                                    <div class="row g-3">
                                        <div class="col-md-5">
                                            <div class="d-flex align-items-center justify-content-between mb-2">
                                                <strong>Name links</strong>
                                                <span class="small text-muted">@person.AliasCount links</span>
                                            </div>
                                            <table class="table table-sm table-striped mb-2">
                                                <thead>
                                                    <tr>
                                                        <th>Name</th>
                                                        <th style="width: 120px;">Type</th>
                                                        <th style="width: 100px;">Confidence</th>
                                                        <th style="width: 80px;">Primary</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var alias in person.Aliases)
                                                    {
                                                        <tr>
                                                            <td>@alias.Alias</td>
                                                            <td>@FormatAliasType(alias)</td>
                                                            <td>@alias.Confidence.ToString("P0")</td>
                                                            <td>@(alias.IsPrimary ? "yes" : "")</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                            <div class="row g-2 align-items-end">
                                                <div class="col-12">
                                                    <TelerikTextBox Value="@GetNewAlias(person.EntityId)"
                                                                    ValueChanged="@((string value) => SetNewAlias(person.EntityId, value))"
                                                                    Placeholder="Add name link, nickname, first name..." />
                                                </div>
                                                <div class="col-md-5">
                                                    <label class="form-label small mb-1">Type</label>
                                                    <select class="form-select form-select-sm" value="@GetNewAliasType(person.EntityId)" @onchange="@((ChangeEventArgs args) => SetNewAliasType(person.EntityId, args.Value?.ToString() ?? ""))">
                                                        <option value="">Optional</option>
                                                        @foreach (var aliasType in AliasTypeOptions)
                                                        {
                                                            <option value="@aliasType">@aliasType</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label small mb-1">Confidence</label>
                                                    <input class="form-control form-control-sm"
                                                           type="number"
                                                           min="0"
                                                           max="1"
                                                           step="0.05"
                                                           value="@GetNewAliasConfidence(person.EntityId).ToString("0.##")"
                                                           @oninput="@((ChangeEventArgs args) => SetNewAliasConfidence(person.EntityId, args.Value?.ToString()))" />
                                                </div>
                                                <div class="col-md-3">
                                                    <TelerikButton OnClick="@(() => AddAliasAsync(person))"
                                                                   Enabled="@CanAddAlias(person.EntityId)">Add</TelerikButton>
                                                </div>
                                            </div>
                                            <div class="mt-3 pt-3 border-top">
                                                <div class="d-flex align-items-center justify-content-between mb-2">
                                                    <strong>Link to another Name</strong>
                                                    <span class="small text-muted">Add a non-destructive link to another name</span>
                                                </div>
                                                <div class="small text-muted mb-2">
                                                    @if (string.IsNullOrWhiteSpace(person.LinkedNameSummary))
                                                    {
                                                        <span>No linked names yet.</span>
                                                    }
                                                    else
                                                    {
                                                        <span>Linked to: @person.LinkedNameSummary</span>
                                                    }
                                                </div>
                                                <div class="row g-2 align-items-end">
                                                    <div class="col-md-7">
                                                        <TelerikDropDownList Data="@GetNameLinkTargets(person.EntityId)"
                                                                         TItem="ResearchPersonGroupDto"
                                                                         TValue="Guid?"
                                                                         TextField="@nameof(ResearchPersonGroupDto.DisplayName)"
                                                                         ValueField="@nameof(ResearchPersonGroupDto.EntityId)"
                                                                         Value="@GetNameLinkTarget(person.EntityId)"
                                                                         ValueChanged="@((Guid? value) => SetNameLinkTarget(person.EntityId, value))"
                                                                         DefaultText="Select name..."
                                                                         Width="100%" />
                                                    </div>
                                                    <div class="col-md-3">
                                                        <label class="form-label small mb-1">Confidence</label>
                                                        <input class="form-control form-control-sm"
                                                               type="number"
                                                               min="0"
                                                               max="1"
                                                               step="0.05"
                                                               value="@GetNameLinkConfidence(person.EntityId).ToString("0.##")"
                                                               @oninput="@((ChangeEventArgs args) => SetNameLinkConfidence(person.EntityId, args.Value?.ToString()))" />
                                                    </div>
                                                    <div class="col-md-2">
                                                        <TelerikButton OnClick="@(() => LinkNameAsync(person))"
                                                                       Enabled="@CanLinkName(person.EntityId)"
                                                                       ThemeColor="@ThemeConstants.Button.ThemeColor.Primary">Link</TelerikButton>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-7">
                                            <div class="d-flex align-items-center justify-content-between mb-2">
                                                <strong>Mentions</strong>
                                                <span class="small text-muted">@person.MentionCount mentions</span>
                                            </div>
                                            <TelerikGrid Data="@person.Mentions"
                                                         Pageable="true"
                                                         PageSize="6"
                                                         Sortable="true"
                                                         Height="260px"
                                                         OnRowClick="@OnNameMentionRowClick">
                                                <GridColumns>
                                                    <GridColumn Field="@nameof(ResearchPersonMentionDto.RawMention)" Title="Mention" Width="160px" />
                                                    <GridColumn Field="@nameof(ResearchPersonMentionDto.SentenceOrdinal)" Title="Sentence" Width="110px" />
                                                    <GridColumn Field="@nameof(ResearchPersonMentionDto.Confidence)" Title="Confidence" DisplayFormat="{0:P0}" Width="120px" />
                                                    <GridColumn Field="@nameof(ResearchPersonMentionDto.SourcePattern)" Title="Evidence" />
                                                </GridColumns>
                                            </TelerikGrid>
                                        </div>
                                    </div>
                                </div>
                            </DetailTemplate>
                        </TelerikGrid>
                    }
                </div>
            </div>

            <div class="card" id="@SentenceGridElementId">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <strong>Sentence view</strong>
                    <span class="small text-muted">@SentenceRows.Count sentences</span>
                </div>
                <div class="card-body p-2">
                    @if (SentenceRows.Count == 0)
                    {
                        <div class="p-3 text-muted">No sentence text available.</div>
                    }
                    else
                    {
                        <TelerikGrid Data="@SentenceRows"
                                     Pageable="true"
                                     PageSize="@SentencePageSize"
                                     Page="@SentenceGridPage"
                                     PageChanged="@((int page) => SentenceGridPage = page)"
                                     Sortable="true"
                                     Resizable="true"
                                     Height="520px"
                                     SelectionMode="@GridSelectionMode.Single"
                                     SelectedItems="@SelectedSentenceRows"
                                     SelectedItemsChanged="@((IEnumerable<SentenceViewRow> rows) => SelectedSentenceRows = rows)">
                            <GridColumns>
                                <GridColumn Field="@nameof(SentenceViewRow.Ordinal)" Title="#" Width="90px" />
                                <GridColumn Title="Sentence">
                                    <Template>
                                        @{
                                            var sentence = (SentenceViewRow)context;
                                        }
                                        <div style="white-space: normal; line-height: 1.45;">
                                            @((MarkupString)System.Net.WebUtility.HtmlEncode(sentence.Text).HighlightSearchTerms(SearchQuery))
                                        </div>
                                    </Template>
                                </GridColumn>
                            </GridColumns>
                        </TelerikGrid>
                    }
                </div>
            </div>
        </div>
    </TabStripTab>
</TelerikTabStrip>

@code {
    [Parameter]
    public SearchResultDto? Document { get; set; }

    [Parameter]
    public int ActiveTabIndex { get; set; }

    [Parameter]
    public EventCallback<int> ActiveTabIndexChanged { get; set; }

    [Parameter]
    public string SearchQuery { get; set; } = "";

    private byte[]? ViewerData { get; set; }
    private bool IsLoadingViewer { get; set; }
    private bool IsScanningNames { get; set; }
    private bool IsLoadingNameScan { get; set; }
    private ResearchDocumentNameScanResult? LastNameScanResult { get; set; }
    private ResearchNameResearchView? NameResearchView { get; set; }
    private List<SentenceViewRow> SentenceRows { get; set; } = new();
    private IEnumerable<SentenceViewRow> SelectedSentenceRows { get; set; } = Enumerable.Empty<SentenceViewRow>();
    private int SentenceGridPage { get; set; } = 1;
    private Dictionary<Guid, string> NewAliasByEntity { get; } = new();
    private Dictionary<Guid, string> NewAliasTypeByEntity { get; } = new();
    private Dictionary<Guid, decimal> NewAliasConfidenceByEntity { get; } = new();
    private Dictionary<Guid, Guid?> NameLinkTargetByEntity { get; } = new();
    private Dictionary<Guid, decimal> NameLinkConfidenceByEntity { get; } = new();
    private string? LoadedViewerPath { get; set; }
    private const int ViewerTabIndex = 1;
    private const int ImagesTabIndex = 2;
    private const int SentencePageSize = 25;
    private readonly string _sentenceGridElementId = $"sentence-grid-{Guid.NewGuid():N}";
    private static readonly string[] AliasTypeOptions =
    {
        "Proper Name",
        "Known As",
        "Nickname",
        "Can be Called",
        "Place Name",
        "Publication Name",
        "Web Site Name"
    };

    // Image tab state

    protected override async Task OnParametersSetAsync()
    {
        var documentKey = GetDocumentKey(Document);
        var documentChanged = documentKey != _lastDocumentKey;

        if (documentChanged)
        {
            _lastDocumentKey = documentKey;
            ViewerData = null;
            LastNameScanResult = null;
            NameResearchView = null;
            SentenceRows = BuildSentenceRows(Document?.Text);
            SelectedSentenceRows = Enumerable.Empty<SentenceViewRow>();
            SentenceGridPage = 1;
            NewAliasByEntity.Clear();
            NewAliasTypeByEntity.Clear();
            NewAliasConfidenceByEntity.Clear();
            NameLinkTargetByEntity.Clear();
            NameLinkConfidenceByEntity.Clear();
            LoadedViewerPath = null;
            _loadedNameScanKey = null;
            ParseImagePages();

            if (ActiveTabIndex == ImagesTabIndex && !ShowImagesTab)
                await OnTabChanged(0);
        }

        if (Document?.FilePath != LoadedViewerPath && ActiveTabIndex == ViewerTabIndex && HasNativeViewer)
        {
            await LoadViewerDataAsync();
        }

        if (ActiveTabIndex == NameResearchTabIndex)
        {
            await LoadSavedNameScanAsync();
        }
    }

    private static string? GetDocumentKey(SearchResultDto? document)
    {
        if (document == null)
            return null;
        if (document.Id != Guid.Empty)
            return document.Id.ToString();
        if (!string.IsNullOrWhiteSpace(document.FilePath))
            return document.FilePath;
        return document.FileName;
    }

    private async Task OnTabChanged(int index)
    {
        ActiveTabIndex = index;
        await ActiveTabIndexChanged.InvokeAsync(index);
        if (index == ViewerTabIndex && HasNativeViewer && ViewerData == null && !IsLoadingViewer)
        {
            await LoadViewerDataAsync();
        }

        if (index == NameResearchTabIndex)
        {
            await LoadSavedNameScanAsync();
        }
    }

    private async Task OnNamePersonRowClick(GridRowClickEventArgs args)
    {
        if (args.Item is not ResearchPersonGroupDto person)
            return;

        var sentence = FindFirstSentenceForPerson(person);
        if (sentence == null)
        {
            NotificationService.ShowInfo($"No sentence occurrence found for {person.DisplayName}.");
            return;
        }

        await JumpToSentenceAsync(sentence);
    }

    private async Task OnNameMentionRowClick(GridRowClickEventArgs args)
    {
        if (args.Item is not ResearchPersonMentionDto mention)
            return;

        var sentence = mention.SentenceOrdinal.HasValue
            ? SentenceRows.FirstOrDefault(row => row.Ordinal == mention.SentenceOrdinal.Value)
            : null;

        if (sentence == null)
            sentence = FindFirstSentenceContaining(mention.RawMention);

        if (sentence == null)
        {
            NotificationService.ShowInfo($"No sentence occurrence found for {mention.RawMention}.");
            return;
        }

        await JumpToSentenceAsync(sentence);
    }

    private async Task JumpToSentenceAsync(SentenceViewRow sentence)
    {
        var index = SentenceRows.FindIndex(row => row.Ordinal == sentence.Ordinal);
        if (index >= 0)
            SentenceGridPage = (index / SentencePageSize) + 1;

        SelectedSentenceRows = new[] { sentence };
        StateHasChanged();
        await Task.Yield();
        await JS.InvokeVoidAsync("scrollElementIntoView", SentenceGridElementId);
    }

    private SentenceViewRow? FindFirstSentenceForPerson(ResearchPersonGroupDto person)
    {
        var mentionWithOrdinal = person.Mentions
            .Where(m => m.SentenceOrdinal.HasValue)
            .OrderBy(m => m.SentenceOrdinal)
            .FirstOrDefault();
        if (mentionWithOrdinal?.SentenceOrdinal is int ordinal)
        {
            var sentence = SentenceRows.FirstOrDefault(row => row.Ordinal == ordinal);
            if (sentence != null)
                return sentence;
        }

        var aliases = person.Aliases.Select(a => a.Alias)
            .Concat(new[] { person.DisplayName, person.CanonicalName })
            .Where(a => !string.IsNullOrWhiteSpace(a))
            .Distinct(StringComparer.OrdinalIgnoreCase);

        foreach (var alias in aliases)
        {
            var sentence = FindFirstSentenceContaining(alias);
            if (sentence != null)
                return sentence;
        }

        return null;
    }

    private SentenceViewRow? FindFirstSentenceContaining(string candidateName)
    {
        var normalizedName = NormalizeForSentenceSearch(candidateName);
        if (string.IsNullOrWhiteSpace(normalizedName))
            return null;

        foreach (var row in SentenceRows.OrderBy(row => row.Ordinal))
        {
            if (NormalizeForSentenceSearch(row.Text).Contains(normalizedName, StringComparison.Ordinal))
                return row;
        }

        var nameParts = normalizedName
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Where(part => part.Length > 1)
            .ToArray();
        if (nameParts.Length <= 1)
            return null;

        foreach (var row in SentenceRows.OrderBy(row => row.Ordinal))
        {
            var normalizedText = NormalizeForSentenceSearch(row.Text);
            if (nameParts.All(part => normalizedText.Contains(part, StringComparison.Ordinal)))
                return row;
        }

        return null;
    }

    private static string NormalizeForSentenceSearch(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "";

        var normalized = value.ToLowerInvariant();
        normalized = System.Text.RegularExpressions.Regex.Replace(normalized, @"[^a-z0-9']+", " ");
        return System.Text.RegularExpressions.Regex.Replace(normalized, @"\s+", " ").Trim();
    }


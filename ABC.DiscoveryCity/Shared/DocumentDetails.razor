@using ABC.DiscoveryCity.Services
@using System.Text.Json
@using static ABC.DiscoveryCity.Services.TextFormatExtensions
@using Telerik.Blazor
@using Telerik.Blazor.Components
@using Telerik.Blazor.Components.Common.Icon
@inject SearchService SearchService
@inject IJSRuntime JS
@inject NotificationService NotificationService

<TelerikTabStrip ActiveTabIndex="@ActiveTabIndex" ActiveTabIndexChanged="@OnTabChanged">
    <TabStripTab Title="Overview">
        <div class="p-3">
             <div class="row">
                <div class="col-md-5">
                    @if (!string.IsNullOrEmpty(Document?.ThumbnailPath))
                    {
                        <img src="@($"{SearchService.ApiBaseUrl}/api/images/view?path={Uri.EscapeDataString(Document.FullImagePath ?? Document.ThumbnailPath)}")"
                             style="width: 100%; height: auto; border: 1px solid var(--kendo-component-border, #ddd); box-shadow: 2px 2px 5px rgba(0,0,0,0.1); max-height: 600px; object-fit: contain;" />
                    }
                    else if (Document?.Id != Guid.Empty)
                    {
                        <img src="@SearchService.GetThumbnailUrl(Document.Id, "full")"
                             style="width: 100%; height: auto; border: 1px solid var(--kendo-component-border, #ddd); box-shadow: 2px 2px 5px rgba(0,0,0,0.1); max-height: 600px; object-fit: contain;"
                             loading="lazy" />
                    }
                    else
                    {
                        <div class="text-center p-5 bg-light text-muted border" style="height: 300px; display: flex; align-items: center; justify-content: center; flex-direction: column;">
                            <TelerikIcon Icon="@FileIcon" Size="large" />
                            <div class="mt-2">@FileCategoryLabel</div>
                        </div>
                    }

                    <div class="mt-4 p-3 bg-light border rounded">
                         <h6 class="border-bottom pb-2">Document Metadata</h6>
                         <ul class="list-unstyled mb-0">
                             <li class="mb-1"><strong>Est. Date:</strong> @(Document?.Date?.ToString("yyyy-MM-dd") ?? "Unknown")</li>
                             <li class="mb-1"><strong>@PageCountLabel:</strong> @Document?.PageCount</li>
                             <li class="mb-1"><strong>Relevance:</strong> @($"{Math.Max(0, (1 - (Document?.Distance ?? 1)) * 100):F0}%")</li>
                             <li class="mb-1"><strong>File:</strong> <span class="text-break">@Document?.FileName</span></li>
                         </ul>
                    </div>
                </div>
                <div class="col-md-7">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h4 class="mb-0">@TextPreviewTitle</h4>
                        @if (!string.IsNullOrEmpty(Document?.Text))
                        {
                            <TelerikButton OnClick="@CopyTextToClipboard" Icon="@SvgIcon.Copy" Title="Copy text to clipboard" />
                        }
                    </div>
                    <div class="card h-100">
                        <div class="card-body" style="max-height: 600px; overflow-y: auto; background-color: var(--kendo-base-bg, #f9f9f9); font-family: 'Consolas', 'Monaco', monospace; font-size: 0.95em; line-height: 1.5;">
                            <div style="color: var(--kendo-subtle-text, #666); margin-bottom: 1em;">[@ContentTypeLabel]<br/><br/></div>
                            @if (!string.IsNullOrEmpty(Document?.Text))
                            {
                                @((MarkupString)Document.Text.FormatWithSentenceBreaks().HighlightSearchTerms(SearchQuery))
                            }
                            else
                            {
                                <span class="text-muted fst-italic">No text content available.</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </TabStripTab>
    <TabStripTab Title="@ViewerTabTitle">
        @if (Category == FileCategory.Pdf)
        {
            <TelerikSplitter Orientation="@SplitterOrientation.Horizontal" Height="800px">
                <SplitterPanes>
                    <SplitterPane Size="55%">
                        <PdfDocumentViewer Data="@ViewerData"
                                           FilePath="@Document?.FilePath"
                                           DownloadUrl="@ReconstructedDownloadUrl"
                                           PreviewImageUrl="@PreviewImageUrl"
                                           AutoLoad="false"
                                           Height="100%" />
                    </SplitterPane>
                    <SplitterPane>
                        <div style="height: 100%; overflow-y: auto; padding: 10px; background-color: var(--kendo-base-bg, #f9f9f9); font-family: 'Consolas', 'Monaco', monospace; font-size: 0.9em; line-height: 1.5;">
                            <div class="d-flex align-items-center justify-content-between" style="color: var(--kendo-subtle-text, #666); margin-bottom: 1em;">
                                <span>[Sentence]</span>
                                @if (!string.IsNullOrEmpty(Document?.Text))
                                {
                                    <TelerikButton OnClick="@CopyTextToClipboard" Icon="@SvgIcon.Copy" Title="Copy text to clipboard" FillMode="@ThemeConstants.Button.FillMode.Flat" />
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(Document?.Text))
                            {
                                @((MarkupString)Document.Text.FormatWithSentenceBreaks().HighlightSearchTerms(SearchQuery))
                            }
                            else
                            {
                                <span class="text-muted fst-italic">No text content available.</span>
                            }
                        </div>
                    </SplitterPane>
                </SplitterPanes>
            </TelerikSplitter>
        }
        else if (HasNativeViewer)
        {
            @if (IsLoadingViewer)
            {
                <div class="d-flex align-items-center justify-content-center" style="height: 800px;">
                    <TelerikLoader Visible="true" />
                    <span class="ms-2">Loading @FileCategoryLabel...</span>
                </div>
            }
            else if (ViewerData != null && ViewerData.Length > 0)
            {
                <TelerikSpreadsheet Data="@ViewerData"
                                    Height="800px"
                                    Width="100%" />
            }
            else
            {
                <div class="d-flex flex-column align-items-center justify-content-center text-muted" style="height: 800px;">
                    <div>
                        <TelerikIcon Icon="@FileIcon" />
                        <span class="ms-2">File not available locally.</span>
                    </div>
                    @if (ReconstructedDownloadUrl != null)
                    {
                        <a href="@ReconstructedDownloadUrl" target="_blank" rel="noopener noreferrer" class="mt-2">
                            <TelerikIcon Icon="@SvgIcon.Download" /> Download from source
                        </a>
                    }
                </div>
            }
        }

        else if (Category == FileCategory.Video && !string.IsNullOrEmpty(FileViewUrl))
        {
            <div style="height: 800px; display: flex; flex-direction: column; background: #000;">
                <video controls style="width: 100%; max-height: 700px; flex: 1;" preload="metadata">
                    <source src="@FileViewUrl" type="@FileContentType" />
                    Your browser does not support the video element.
                </video>
                <div style="padding: 8px 12px; background: var(--kendo-base-bg, #1a1a1a); color: var(--kendo-subtle-text, #aaa); font-size: 0.85em;">
                    @Document?.FileName
                    @if (!string.IsNullOrEmpty(Document?.Text))
                    {
                        <span class="ms-3">@Document.Text.Replace("\n", " ").Trim()</span>
                    }
                </div>
            </div>
        }
        else if (Category == FileCategory.Audio && !string.IsNullOrEmpty(FileViewUrl))
        {
            <div style="height: 800px; padding: 20px; background-color: var(--kendo-base-bg, #f9f9f9);">
                <div class="mb-3 d-flex align-items-center gap-2">
                    <TelerikIcon Icon="@FileIcon" />
                    <strong>@Document?.FileName</strong>
                </div>
                <audio controls style="width: 100%;" preload="metadata">
                    <source src="@FileViewUrl" type="@FileContentType" />
                    Your browser does not support the audio element.
                </audio>
                @if (!string.IsNullOrEmpty(Document?.Text))
                {
                    <div style="margin-top: 16px; font-family: 'Consolas', monospace; font-size: 0.9em; color: var(--kendo-subtle-text, #666);">
                        @((MarkupString)Document.Text.FormatWithSentenceBreaks())
                    </div>
                }
            </div>
        }
        else if (Category == FileCategory.Image)
        {
            @* Use preview image if available (smaller), fall back to full original, then FilePath *@
            var imgUrl = ImageViewerUrl;

            if (!string.IsNullOrEmpty(imgUrl))
            {
                <div style="height: 800px; display: flex; flex-direction: column; align-items: center; justify-content: center; background: var(--kendo-base-bg, #1a1a1a); overflow: auto;">
                    <img src="@imgUrl" style="max-width: 100%; max-height: 750px; object-fit: contain;" alt="@Document?.FileName" />
                    <div style="padding: 8px; color: var(--kendo-subtle-text, #aaa); font-size: 0.85em;">
                        @Document?.FileName
                        @if (!string.IsNullOrEmpty(Document?.Text))
                        {
                            <span class="ms-3">@Document.Text.Replace("\n", " ").Trim()</span>
                        }
                    </div>
                </div>
            }
            else
            {
                <div style="height: 800px; display: flex; align-items: center; justify-content: center; color: var(--kendo-subtle-text, #aaa);">
                    No image path available for @Document?.FileName
                </div>
            }
        }
        else
        {
            <div style="height: 800px; overflow-y: auto; padding: 20px; background-color: var(--kendo-base-bg, #f9f9f9); font-family: 'Consolas', 'Monaco', monospace; font-size: 0.9em; line-height: 1.5;">
                <div class="mb-3 d-flex align-items-center gap-2">
                    <TelerikIcon Icon="@FileIcon" />
                    <strong>@FileCategoryLabel</strong>
                    <span class="text-muted">— @Document?.FileName</span>
                </div>
                <div style="color: var(--kendo-subtle-text, #666); margin-bottom: 1em;">[@ContentTypeLabel]<br/><br/></div>
                @if (!string.IsNullOrEmpty(Document?.Text))
                {
                    @((MarkupString)Document.Text.FormatWithSentenceBreaks().HighlightSearchTerms(SearchQuery))
                }
                else
                {
                    <span class="text-muted fst-italic">No content available.</span>
                    @if (ReconstructedDownloadUrl != null)
                    {
                        <div class="mt-2">
                            <a href="@ReconstructedDownloadUrl" target="_blank" rel="noopener noreferrer">
                                <TelerikIcon Icon="@SvgIcon.Download" /> Download from source
                            </a>
                        </div>
                    }
                }
            </div>
        }
    </TabStripTab>
    <TabStripTab Title="Images" Visible="@(Category == FileCategory.Pdf && _imagePages.Count > 0)">
        <div class="p-3">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <TelerikButton OnClick="@PrevImagePage" Icon="@SvgIcon.ChevronLeft"
                                   Enabled="@(_imagePageIndex > 0)" Title="Previous image" />
                    <span style="font-weight: 600;">Image @(_imagePageIndex + 1) of @_imagePages.Count</span>
                    <TelerikButton OnClick="@NextImagePage" Icon="@SvgIcon.ChevronRight"
                                   Enabled="@(_imagePageIndex < _imagePages.Count - 1)" Title="Next image" />
                </div>
                <span style="color: var(--kendo-subtle-text, #888); font-size: 0.9em;">
                    Page @(_imagePages.Count > 0 ? _imagePages[_imagePageIndex].Page : 0) &bull; @(_imagePages.Count > 0 ? _imagePages[_imagePageIndex].Info : "")
                </span>
            </div>
            @if (_imagePages.Count > 0 && Document?.Id != Guid.Empty)
            {
                <img src="@SearchService.GetPageImageUrl(Document!.Id, _imagePages[_imagePageIndex].Page)"
                     style="width: 100%; height: auto; border: 1px solid var(--kendo-component-border, #ddd); box-shadow: 2px 2px 5px rgba(0,0,0,0.1); max-height: 700px; object-fit: contain;" />
            }
        </div>
    </TabStripTab>
    <TabStripTab Title="Metadata">
        <div class="p-3">
            @if (!string.IsNullOrEmpty(RemoteUrl))
            {
                <div class="mb-3 p-3 bg-light border rounded">
                    <h6 class="border-bottom pb-2">Remote Source</h6>
                    <a href="@RemoteUrl" target="_blank" rel="noopener noreferrer" class="text-break">
                        <TelerikIcon Icon="@SvgIcon.HyperlinkOpen" /> @RemoteUrl
                    </a>
                </div>
            }
            <div class="card">
                <div class="card-header"><strong>Document Metadata (JSONB)</strong></div>
                <div class="card-body" style="max-height: 600px; overflow-y: auto;">
                    @if (MetadataEntries.Count > 0)
                    {
                        <table class="table table-sm table-striped mb-0">
                            <thead>
                                <tr><th style="width: 200px;">Property</th><th>Value</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var entry in MetadataEntries)
                                {
                                    <tr>
                                        <td><strong>@entry.Key</strong></td>
                                        <td class="text-break" style="font-family: 'Consolas', monospace; font-size: 0.9em;">@((MarkupString)System.Net.WebUtility.HtmlEncode(entry.Value).HighlightSearchTerms(SearchQuery))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <span class="text-muted fst-italic">No metadata available.</span>
                    }
                </div>
            </div>
        </div>
    </TabStripTab>
</TelerikTabStrip>

@code {
    [Parameter]
    public SearchResultDto? Document { get; set; }

    [Parameter]
    public int ActiveTabIndex { get; set; }

    [Parameter]
    public EventCallback<int> ActiveTabIndexChanged { get; set; }

    [Parameter]
    public string SearchQuery { get; set; } = "";

    private byte[]? ViewerData { get; set; }
    private bool IsLoadingViewer { get; set; }
    private string? LoadedViewerPath { get; set; }

    // Image tab state
    private record ImagePageInfo(int Page, string Info);
    private List<ImagePageInfo> _imagePages = new();
    private int _imagePageIndex;
    private Guid _lastImageDocId;

    private void ParseImagePages()
    {
        _imagePages.Clear();
        _imagePageIndex = 0;
        if (Document?.Text == null) return;

        // Parse [image.sz(...,pN)] markers from document text
        var regex = new System.Text.RegularExpressions.Regex(@"\[image\.sz\(([^)]+)\)\]");
        foreach (System.Text.RegularExpressions.Match m in regex.Matches(Document.Text))
        {
            var parts = m.Groups[1].Value;
            // Last part is pN (page number)
            var pageMatch = System.Text.RegularExpressions.Regex.Match(parts, @"p(\d+)");
            if (pageMatch.Success && int.TryParse(pageMatch.Groups[1].Value, out int page))
            {
                // Build info string from the marker parts
                var info = parts.Replace($",{pageMatch.Value}", "").Replace($"{pageMatch.Value},", "");
                _imagePages.Add(new ImagePageInfo(page, info));
            }
        }

        // Deduplicate by page number, keep first
        _imagePages = _imagePages.GroupBy(p => p.Page).Select(g => g.First()).OrderBy(p => p.Page).ToList();
    }

    private void NextImagePage()
    {
        if (_imagePageIndex < _imagePages.Count - 1)
            _imagePageIndex++;
    }

    private void PrevImagePage()
    {
        if (_imagePageIndex > 0)
            _imagePageIndex--;
    }

    private string RemoteUrl => Document?.SourceUrl ?? "";

    private string? ReconstructedDownloadUrl
    {
        get
        {
            if (string.IsNullOrEmpty(Document?.SourceUrl) || string.IsNullOrEmpty(Document?.FileName))
                return null;
            var baseUrl = Document.SourceUrl.TrimEnd('/');
            if (!string.IsNullOrEmpty(Document.DataSetName))
                return $"{baseUrl}/{Uri.EscapeDataString(Document.DataSetName)}/{Uri.EscapeDataString(Document.FileName)}";
            return $"{baseUrl}/{Uri.EscapeDataString(Document.FileName)}";
        }
    }

    private string? FileViewUrl
    {
        get
        {
            var path = Document?.FilePath;
            return string.IsNullOrEmpty(path)
                ? null
                : $"{SearchService.ApiBaseUrl}/api/images/view?path={Uri.EscapeDataString(path)}";
        }
    }

    private string FileContentType => FileExtension switch
    {
        ".mp4" => "video/mp4",
        ".avi" => "video/x-msvideo",
        ".mov" => "video/quicktime",
        ".mkv" => "video/x-matroska",
        ".wmv" => "video/x-ms-wmv",
        ".vob" => "video/mpeg",
        ".m4a" => "audio/mp4",
        ".mp3" => "audio/mpeg",
        ".wav" => "audio/wav",
        ".ogg" => "audio/ogg",
        ".flac" => "audio/flac",
        ".aac" => "audio/aac",
        ".jpg" or ".jpeg" => "image/jpeg",
        ".png" => "image/png",
        ".gif" => "image/gif",
        ".webp" => "image/webp",
        _ => "application/octet-stream"
    };

    /// <summary>
    /// Best URL for the image viewer: preview (800px) > full image > original file.
    /// </summary>
    private string? ImageViewerUrl
    {
        get
        {
            if (!string.IsNullOrEmpty(Document?.FullImagePath))
                return $"{SearchService.ApiBaseUrl}/api/images/view?path={Uri.EscapeDataString(Document.FullImagePath)}";
            if (!string.IsNullOrEmpty(Document?.ThumbnailPath))
                return $"{SearchService.ApiBaseUrl}/api/images/view?path={Uri.EscapeDataString(Document.ThumbnailPath)}";
            return FileViewUrl;
        }
    }

    private List<KeyValuePair<string, string>> MetadataEntries => ParseMetadata();

    private enum FileCategory { Pdf, Spreadsheet, Video, Audio, Image, Unknown }

    private FileCategory Category => GetFileCategory();

    private string FileExtension =>
        System.IO.Path.GetExtension(Document?.FileName ?? "").ToLowerInvariant();

    /// <summary>
    /// True when the file type has a native Telerik viewer (PDF or any spreadsheet).
    /// The API converts .xls/.csv to .xlsx on the fly for the TelerikSpreadsheet control.
    /// </summary>
    private bool HasNativeViewer => Category == FileCategory.Pdf || Category == FileCategory.Spreadsheet;

    private string? PreviewImageUrl
    {
        get
        {
            var imagePath = Document?.FullImagePath ?? Document?.ThumbnailPath;
            return string.IsNullOrEmpty(imagePath)
                ? null
                : $"{SearchService.ApiBaseUrl}/api/images/view?path={Uri.EscapeDataString(imagePath)}";
        }
    }
//
    private FileCategory GetFileCategory()
    {
        return FileExtension switch
        {
            ".pdf" => FileCategory.Pdf,
            ".xlsx" or ".xls" or ".csv" => FileCategory.Spreadsheet,
            ".avi" or ".mp4" or ".vob" or ".mov" or ".mkv" or ".wmv" => FileCategory.Video,
            ".m4a" or ".mp3" or ".wav" or ".aac" or ".ogg" or ".flac" => FileCategory.Audio,
            ".jpg" or ".jpeg" or ".png" or ".gif" or ".bmp" or ".tiff" or ".tif" or ".cr2" or ".webp" => FileCategory.Image,
            _ => FileCategory.Unknown
        };
    }
  
    private ISvgIcon FileIcon => Category switch
    {
        FileCategory.Pdf => SvgIcon.FilePdf,
        FileCategory.Spreadsheet => SvgIcon.FileExcel,
        FileCategory.Video => SvgIcon.FileVideo,
        FileCategory.Audio => SvgIcon.FileAudio,
        FileCategory.Image => SvgIcon.Image,
        _ => SvgIcon.File
    };
    //

    private string FileCategoryLabel => Category switch
    {
        FileCategory.Pdf => "PDF Document",
        FileCategory.Spreadsheet => "Spreadsheet",
        FileCategory.Video => "Video File",
        FileCategory.Audio => "Audio File",
        FileCategory.Image => "Image",
        _ => "Document"
    };

    private string ViewerTabTitle => Category switch
    {
        FileCategory.Pdf => "PDF Viewer",
        FileCategory.Spreadsheet => "Spreadsheet Viewer",
        FileCategory.Video or FileCategory.Audio => "Media Info",
        FileCategory.Image => "Image Viewer",
        _ => "Document Viewer"
    };

    private string PageCountLabel => Category switch
    {
        FileCategory.Spreadsheet => "Sheets",
        _ => "Pages"
    };

    private string TextPreviewTitle => Category switch
    {
        FileCategory.Spreadsheet => "Spreadsheet Content",
        FileCategory.Video or FileCategory.Audio => "Media Metadata",
        FileCategory.Image => "Image Metadata",
        _ => "Text Preview"
    };

    private string ContentTypeLabel => Category switch
    {
        FileCategory.Spreadsheet => "Row",
        FileCategory.Video or FileCategory.Audio => "Metadata",
        FileCategory.Image => "EXIF",
        _ => "Sentence"
    };

    protected override async Task OnParametersSetAsync()
    {
        if (Document?.FilePath != LoadedViewerPath)
        {
            ViewerData = null;
            LoadedViewerPath = null;

            // Parse image pages when document changes
            if (Document?.Id != _lastImageDocId)
            {
                _lastImageDocId = Document?.Id ?? Guid.Empty;
                ParseImagePages();
            }

            // Keep current tab — parent controls ActiveTabIndex
            // If already on Viewer tab, auto-load the new document
            if (ActiveTabIndex == 1 && HasNativeViewer)
            {
                await LoadViewerDataAsync();
            }
        }
    }

    private async Task OnTabChanged(int index)
    {
        ActiveTabIndex = index;
        await ActiveTabIndexChanged.InvokeAsync(index);
        if (index == 1 && HasNativeViewer && ViewerData == null && !IsLoadingViewer)
        {
            await LoadViewerDataAsync();
        }
    }

    private async Task LoadViewerDataAsync()
    {
        if (Document == null || string.IsNullOrEmpty(Document.FilePath)) return;
        IsLoadingViewer = true;
        StateHasChanged();
        try
        {
            ViewerData = Category == FileCategory.Spreadsheet
                ? await SearchService.GetSpreadsheetBytesAsync(Document.FilePath)
                : await SearchService.GetPdfBytesAsync(Document.FilePath);
            LoadedViewerPath = Document.FilePath;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Viewer data load error: {ex.Message}");
        }
        finally
        {
            IsLoadingViewer = false;
        }
    }

    private List<KeyValuePair<string, string>> ParseMetadata()
    {
        var entries = new List<KeyValuePair<string, string>>();
        if (Document == null || string.IsNullOrEmpty(Document.MetadataJson) || Document.MetadataJson == "{}")
            return entries;

        try
        {
            using var doc = JsonDocument.Parse(Document.MetadataJson);
            foreach (var prop in doc.RootElement.EnumerateObject())
            {
                string value = prop.Value.ValueKind switch
                {
                    JsonValueKind.Array => string.Join(", ", prop.Value.EnumerateArray().Select(e => e.ToString())),
                    JsonValueKind.Null => "",
                    _ => prop.Value.ToString()
                };
                if (!string.IsNullOrEmpty(value))
                {
                    // Strip drive/mount prefixes from path-like values
                    if (prop.Name.Contains("Path", StringComparison.OrdinalIgnoreCase)
                        || prop.Name.Contains("Folder", StringComparison.OrdinalIgnoreCase))
                    {
                        value = StripDrivePrefix(value);
                    }
                    entries.Add(new KeyValuePair<string, string>(prop.Name, value));
                }
            }
        }
        catch { }

        return entries;
    }

    private async Task CopyTextToClipboard()
    {
        if (string.IsNullOrEmpty(Document?.Text)) return;
        try
        {
            var success = await JS.InvokeAsync<bool>("copyTextToClipboard", Document.Text);
            if (success)
                NotificationService.ShowSuccess("Text copied to clipboard");
            else
                NotificationService.ShowWarning("Could not copy text — clipboard access denied");
        }
        catch (Exception ex)
        {
            NotificationService.ShowError($"Copy failed: {ex.Message}");
        }
    }

    private static string StripDrivePrefix(string path)
    {
        var segments = path.Replace('\\', '/').Split('/', StringSplitOptions.RemoveEmptyEntries);

        for (int i = 0; i < segments.Length; i++)
        {
            if (segments[i].Equals("EpsteinFiles", StringComparison.OrdinalIgnoreCase)
                || segments[i].Equals("Downloads", StringComparison.OrdinalIgnoreCase)
                || segments[i].Equals("Developer.DiscoveryCity", StringComparison.OrdinalIgnoreCase))
            {
                if (i + 1 < segments.Length)
                    return "[drive]/" + string.Join("/", segments[(i + 1)..]);
                return "[drive]/" + segments[i];
            }
        }

        if (path.StartsWith("/media/", StringComparison.OrdinalIgnoreCase) && segments.Length > 3)
            return "[drive]/" + string.Join("/", segments[3..]);
        if (path.Length >= 3 && path[1] == ':' && (path[2] == '\\' || path[2] == '/'))
            return "[drive]/" + string.Join("/", segments[1..]);

        return path;
    }
}

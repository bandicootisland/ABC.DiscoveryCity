    private async Task AddAliasAsync(ResearchPersonGroupDto person)
    {
        var alias = GetNewAlias(person.EntityId).Trim();
        if (string.IsNullOrWhiteSpace(alias))
            return;

        var saved = await SearchService.AddResearchPersonAliasAsync(
            person.EntityId,
            alias,
            aliasType: GetNewAliasType(person.EntityId),
            confidence: GetNewAliasConfidence(person.EntityId));
        if (saved == null)
            return;

        NewAliasByEntity.Remove(person.EntityId);
        NewAliasTypeByEntity.Remove(person.EntityId);
        NewAliasConfidenceByEntity.Remove(person.EntityId);
        await LoadSavedNameScanAsync(force: true);
        NotificationService.ShowSuccess($"Added name link \"{saved.Alias}\" to {person.DisplayName}.");
    }

    private async Task LinkNameAsync(ResearchPersonGroupDto person)
    {
        var targetEntityId = GetNameLinkTarget(person.EntityId);
        if (targetEntityId is not Guid target || target == Guid.Empty || target == person.EntityId)
            return;

        var result = await SearchService.LinkResearchNamesAsync(person.EntityId, target, GetNameLinkConfidence(person.EntityId));
        if (result == null)
            return;

        NameLinkTargetByEntity.Remove(person.EntityId);
        NameLinkConfidenceByEntity.Remove(person.EntityId);
        await LoadSavedNameScanAsync(force: true);
        NotificationService.ShowSuccess(
            $"Linked {person.DisplayName} to {result.TargetDisplayName}.");
    }


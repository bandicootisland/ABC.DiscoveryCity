# ===========================================
# Large Files - Prevent push timeouts
# ===========================================

# Large dictionary/book DATA files (code files ARE tracked)
# Data files in OxfordEnglishDictionaryCD
ABC.BookPack.Dictionaries/OxfordEnglishDictionaryCD/*.json
ABC.BookPack.Dictionaries/OxfordEnglishDictionaryCD/*.xml
ABC.BookPack.Dictionaries/OxfordEnglishDictionaryCD/*.csv
ABC.BookPack.Dictionaries/OxfordEnglishDictionaryCD/*.txt

# Books folders - entire folders ignored (no code here, only data)
ABC.BookPack.Dictionaries/Books/
ABC.BookPack.Research/Books/
ABC.BookPack.AtlasoftheHumanBrain/Books/

# Large binary/archive files
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz

# Large media files
*.mp4
*.mp3
*.avi
*.mov
*.mkv
*.wav
*.flac

# Large image files
*.psd
*.ai
*.tiff
*.tif
*.bmp
*.raw

# Database files
*.mdf
*.ldf
*.bak
*.sql.gz

# Large document files (UNCOMMENT if you don't need these tracked)
# *.pdf
# *.epub
# *.mobi

# Disk images
*.iso
*.img
*.dmg
*.vhd
*.vhdx

# Package/installer files
*.msi
# *.exe  # Uncomment if you don't need executables
# *.dll  # Uncomment if you don't need DLLs (careful - may break builds)
*.nupkg

# Large data files (UNCOMMENT if you don't need these tracked)
# *.csv
# *.xlsx
# *.json

*.xsd.cs

# OpenCover UI analysis results
OpenCover/

# Azure Stream Analytics local run output
ASALocalRun/

# MSBuild Binary and Structured Log
*.binlog

# NVidia Nsight GPU debugger configuration file
*.nvuser

# MFractors (Xamarin productivity tool) working folder
.mfractor/

# Local History for Visual Studio
.localhistory/

# Visual Studio History (VSHistory) files
.vshistory/

# BeatPulse healthcheck temp database
healthchecksdb

# Backup folder for Package Reference Convert tool in Visual Studio 2017
MigrationBackup/

# Ionide (cross platform F# VS Code tools) working folder
.ionide/

# Fody - auto-generated XML schema
FodyWeavers.xsd

